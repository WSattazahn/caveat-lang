{
  "schema": "caveat-scenarios/0.1",
  "source": "release-readiness.cav",
  "scenarios": [
    {
      "id": "RR01",
      "title": "Actual October 15 preview observations do not approve a future stable release",
      "steps": [
        {
          "send": "record_preview"
        },
        {
          "send": "review_preview"
        },
        {
          "send": "window_reported",
          "payload": {
            "receipt": "2026-10-15:Oct12-freeze-review:Oct26-not-reached",
            "complete": 0
          }
        },
        {
          "send": "assess_stable",
          "rejected": "No stable candidate selected."
        },
        {
          "expect": {
            "/bindings/preview/status": "verified rc.20 observations",
            "/bindings/stable/status": "missing candidate",
            "/bindings/stable/revisions": 0,
            "/decision_journal/0/commitment": "stabilization@1",
            "/commitment_grounds/stable_release@1": {
              "$absent": true
            }
          }
        },
        {
          "resume": true
        },
        {
          "send": "record_preview",
          "rejected": "Preview receipts already recorded."
        },
        {
          "send": "review_preview",
          "rejected": "Preview already reviewed."
        }
      ]
    },
    {
      "id": "RR02",
      "title": "Preview identity, wrong exact artifact, and candidate changes cannot borrow stable evidence",
      "steps": [
        {
          "send": "select_candidate",
          "payload": {
            "artifact": "0.1.0-rc.20:d9e398e:8b4e6b48",
            "kind": "preview"
          },
          "rejected": "A preview is not a stable candidate."
        },
        {
          "send": "select_candidate",
          "payload": {
            "artifact": "hypothetical:1.0.0:revision-a:sha256-artifact-a",
            "kind": "stable"
          }
        },
        {
          "send": "select_candidate",
          "payload": {
            "artifact": "other-stable-artifact",
            "kind": "stable"
          },
          "rejected": "Use a fresh session for another candidate."
        },
        {
          "send": "checks_reported",
          "payload": {
            "artifact": "wrong-hash",
            "receipt": "wrong-check",
            "passed": 1
          },
          "rejected": "Checks are not for the selected stable artifact."
        },
        {
          "send": "compatibility_reported",
          "payload": {
            "artifact": "wrong-revision",
            "receipt": "wrong-compatibility",
            "passed": 1
          },
          "rejected": "Compatibility review is not for the selected stable artifact."
        },
        {
          "send": "triage_reported",
          "payload": {
            "artifact": "wrong-version",
            "receipt": "wrong-triage",
            "passed": 1
          },
          "rejected": "Triage is not for the selected stable artifact."
        },
        {
          "send": "owner_approved",
          "payload": {
            "artifact": "old-approved-artifact",
            "receipt": "wrong-approval"
          },
          "rejected": "Approval is not for the selected stable artifact."
        },
        {
          "expect": {
            "/bindings/stable/artifact": "hypothetical:1.0.0:revision-a:sha256-artifact-a",
            "/bindings/stable/check_observations": 0,
            "/identifiers": [
              "hypothetical:1.0.0:revision-a:sha256-artifact-a"
            ]
          }
        }
      ]
    },
    {
      "id": "RR03",
      "title": "Every missing evidence category and missing owner grant blocks stable assessment",
      "steps": [
        {
          "send": "assess_stable",
          "rejected": "No stable candidate selected."
        },
        {
          "send": "select_candidate",
          "payload": {
            "artifact": "hypothetical:1.0.0:revision-a:sha256-artifact-a",
            "kind": "stable"
          }
