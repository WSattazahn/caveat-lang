        {
          "expect": {
            "/bindings/stable/status": "recorded eligible; host authorization still required",
            "/bindings/stable/revisions": 1,
            "/decision_journal/0/permitted_by": "approvals@1",
            "/decision_journal/0/value": 4
          }
        },
        {
          "send": "assess_stable",
          "rejected": "Stable candidate already assessed."
        }
      ]
    },
