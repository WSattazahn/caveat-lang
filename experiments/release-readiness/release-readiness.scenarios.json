        {
          "send": "compatibility_reported",
          "payload": {
            "artifact": "hypothetical:1.0.0:revision-a:sha256-artifact-a",
            "receipt": "compatibility-1",
            "passed": 1
          }
        },
        {
          "send": "assess_stable",
          "rejected": "Missing supported-contract defect triage."
        },
        {
          "send": "triage_reported",
          "payload": {
            "artifact": "hypothetical:1.0.0:revision-a:sha256-artifact-a",
            "receipt": "triage-1",
            "passed": 1
          }
        },
        {
          "send": "assess_stable",
          "rejected": "Missing dated stabilization review."
        },
        {
          "send": "window_reported",
          "payload": {
            "receipt": "window-1",
            "complete": 1
          }
        },
        {
          "send": "assess_stable",
          "rejected": {
            "origin": "policy",
            "code": "not_permitted"
          }
        },
        {
          "send": "owner_approved",
          "payload": {
            "artifact": "hypothetical:1.0.0:revision-a:sha256-artifact-a",
            "receipt": "approval-1"
          }
        },
        {
          "send": "assess_stable"
