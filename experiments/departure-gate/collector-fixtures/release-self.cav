claim seen;
evidence a from "a"; renewable a window 1;
state tick = 0; state divisor = 1;
event cycle; event release; event fail;
state held0 = 0;
state held1 = 0;
state held2 = 0;
state held3 = 0;
state held4 = 0;
state held5 = 0;
state held6 = 0;
state held7 = 0;
on cycle renew a;
on cycle reveal a supports seen;
on cycle withdraw a because a;
on cycle when tick >= 0 and tick < 500 set held0 = held0 + qualified(1, a);
on cycle when tick >= 500 and tick < 1000 set held1 = held1 + qualified(1, a);
on cycle when tick >= 1000 and tick < 1500 set held2 = held2 + qualified(1, a);
on cycle when tick >= 1500 and tick < 2000 set held3 = held3 + qualified(1, a);
on cycle when tick >= 2000 and tick < 2500 set held4 = held4 + qualified(1, a);
on cycle when tick >= 2500 and tick < 3000 set held5 = held5 + qualified(1, a);
on cycle when tick >= 3000 and tick < 3500 set held6 = held6 + qualified(1, a);
on cycle when tick >= 3500 and tick < 4000 set held7 = held7 + qualified(1, a);
on cycle set tick = tick + 1;
on release set held0 = 0;
on release set held1 = 0;
on release set held2 = 0;
on release set held3 = 0;
on release set held4 = 0;
on release set held5 = 0;
on release set held6 = 0;
on release set held7 = 0;
on fail set held0 = 0;
on fail set held1 = 0;
on fail set held2 = 0;
on fail set held3 = 0;
on fail set held4 = 0;
on fail set held5 = 0;
on fail set held6 = 0;
on fail set held7 = 0;
on fail set divisor = 0;
bind hud.guard = 1 / divisor;
