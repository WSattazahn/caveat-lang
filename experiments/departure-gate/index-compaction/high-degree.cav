# Fixed 16-owner/16-subject high-degree fixture; repeated cycles do not grow its live index.
# Shared by index-compaction profiling and native semantic regressions.
claim seen;
evidence s00 from "s00"; renewable s00 window 1;
evidence s01 from "s01"; renewable s01 window 1;
evidence s02 from "s02"; renewable s02 window 1;
evidence s03 from "s03"; renewable s03 window 1;
evidence s04 from "s04"; renewable s04 window 1;
evidence s05 from "s05"; renewable s05 window 1;
evidence s06 from "s06"; renewable s06 window 1;
evidence s07 from "s07"; renewable s07 window 1;
evidence s08 from "s08"; renewable s08 window 1;
evidence s09 from "s09"; renewable s09 window 1;
evidence s10 from "s10"; renewable s10 window 1;
evidence s11 from "s11"; renewable s11 window 1;
evidence s12 from "s12"; renewable s12 window 1;
evidence s13 from "s13"; renewable s13 window 1;
evidence s14 from "s14"; renewable s14 window 1;
evidence s15 from "s15"; renewable s15 window 1;
evidence zreason from "shared reason"; renewable zreason window 1;
state root0 = 0;
state root1 = 0;
state root2 = 0;
state root3 = 0;
state root4 = 0;
state root5 = 0;
state root6 = 0;
state root7 = 0;
state root8 = 0;
state root9 = 0;
state root10 = 0;
state root11 = 0;
state root12 = 0;
state root13 = 0;
state root14 = 0;
state root15 = 0;
state single = 0; state divisor = 1;
event cycle; event create; event duplicate; event retire;
event same; event trim; event expand;
event clear index min 0 max 15; event refuse index min 0 max 15;
event fail; event release; event release_single;
proc create_group() {
  renew zreason; reveal zreason supports seen;
  renew s00; reveal s00 supports seen;
  renew s01; reveal s01 supports seen;
  renew s02; reveal s02 supports seen;
  renew s03; reveal s03 supports seen;
  renew s04; reveal s04 supports seen;
  renew s05; reveal s05 supports seen;
  renew s06; reveal s06 supports seen;
  renew s07; reveal s07 supports seen;
  renew s08; reveal s08 supports seen;
  renew s09; reveal s09 supports seen;
  renew s10; reveal s10 supports seen;
  renew s11; reveal s11 supports seen;
  renew s12; reveal s12 supports seen;
  renew s13; reveal s13 supports seen;
  renew s14; reveal s14 supports seen;
  renew s15; reveal s15 supports seen;
};
proc hold_group() {
  withdraw zreason because zreason;
  withdraw s00 because zreason;
  withdraw s01 because zreason;
  withdraw s02 because zreason;
  withdraw s03 because zreason;
  withdraw s04 because zreason;
  withdraw s05 because zreason;
  withdraw s06 because zreason;
  withdraw s07 because zreason;
  withdraw s08 because zreason;
  withdraw s09 because zreason;
  withdraw s10 because zreason;
  withdraw s11 because zreason;
  withdraw s12 because zreason;
  withdraw s13 because zreason;
  withdraw s14 because zreason;
  withdraw s15 because zreason;
  set root0 = qualified(1, s00) + qualified(1, s01) + qualified(1, s02) + qualified(1, s03) + qualified(1, s04) + qualified(1, s05) + qualified(1, s06) + qualified(1, s07) + qualified(1, s08) + qualified(1, s09) + qualified(1, s10) + qualified(1, s11) + qualified(1, s12) + qualified(1, s13) + qualified(1, s14) + qualified(1, s15);
  set root1 = root0;
  set root2 = root0;
  set root3 = root0;
  set root4 = root0;
  set root5 = root0;
  set root6 = root0;
  set root7 = root0;
  set root8 = root0;
  set root9 = root0;
  set root10 = root0;
  set root11 = root0;
  set root12 = root0;
  set root13 = root0;
  set root14 = root0;
  set root15 = root0;
  set single = qualified(1, s00);
};
proc retire_group() {
  renew s00;
  renew s01;
  renew s02;
  renew s03;
  renew s04;
  renew s05;
  renew s06;
  renew s07;
  renew s08;
  renew s09;
  renew s10;
  renew s11;
  renew s12;
  renew s13;
  renew s14;
  renew s15;
  renew zreason;
};
proc release_group() {
  set root0 = 0;
  set root1 = 0;
  set root2 = 0;
  set root3 = 0;
  set root4 = 0;
  set root5 = 0;
  set root6 = 0;
  set root7 = 0;
  set root8 = 0;
  set root9 = 0;
  set root10 = 0;
  set root11 = 0;
  set root12 = 0;
  set root13 = 0;
  set root14 = 0;
  set root15 = 0;
  set single = 0;
};
on cycle call create_group();
on cycle call hold_group();
on cycle call retire_group();
on create call create_group();
on duplicate call hold_group();
on retire call retire_group();
on same set root0 = root1;
on trim set root0 = single;
on expand set root0 = root1;
on clear when index == 0 set root0 = 0;
on refuse when index == 0 set root0 = 0;
on clear when index == 1 set root1 = 0;
on refuse when index == 1 set root1 = 0;
on clear when index == 2 set root2 = 0;
on refuse when index == 2 set root2 = 0;
on clear when index == 3 set root3 = 0;
on refuse when index == 3 set root3 = 0;
on clear when index == 4 set root4 = 0;
on refuse when index == 4 set root4 = 0;
on clear when index == 5 set root5 = 0;
on refuse when index == 5 set root5 = 0;
on clear when index == 6 set root6 = 0;
on refuse when index == 6 set root6 = 0;
on clear when index == 7 set root7 = 0;
on refuse when index == 7 set root7 = 0;
on clear when index == 8 set root8 = 0;
on refuse when index == 8 set root8 = 0;
on clear when index == 9 set root9 = 0;
on refuse when index == 9 set root9 = 0;
on clear when index == 10 set root10 = 0;
on refuse when index == 10 set root10 = 0;
on clear when index == 11 set root11 = 0;
on refuse when index == 11 set root11 = 0;
on clear when index == 12 set root12 = 0;
on refuse when index == 12 set root12 = 0;
on clear when index == 13 set root13 = 0;
on refuse when index == 13 set root13 = 0;
on clear when index == 14 set root14 = 0;
on refuse when index == 14 set root14 = 0;
on clear when index == 15 set root15 = 0;
on refuse when index == 15 set root15 = 0;
on refuse reject "keep all roots";
on fail call release_group();
on fail set divisor = 0;
on release call release_group();
on release_single set root0 = 0;
on release_single set single = 0;
bind hud.guard = 1 / divisor;
