# Several independent models vote on each case, and a case is approved when
# at least two of the three agree. The decision is grounded on the votes that
# agreed, and only on those. When a model is found unreliable, every vote it
# cast is withdrawn in one step, and each decision its vote tipped (one that
# would not have passed without it) is reopened. A decision that still has
# two agreeing votes holds, and its record says it rests on a withdrawn vote.
scene "Decisions that rest on several models' votes.";

place panel kind model;
entity m1 kind model at panel;
entity m2 kind model at panel;
entity m3 kind model at panel;
place docket kind case;
entity case_a kind case at docket;
entity case_b kind case at docket;

event vote case kind case, model kind model, verdict min 0 max 1;
event decide case kind case;
event distrust model kind model;

for model as $m routed by model {
    evidence $m_out from "what $m answered";
    evidence $m_bad from "a finding that $m is unreliable";
    on vote when not observed($m_out) reveal $m_out;
    for case as $c routed by case {
        readings $c_$m_vote from $m_out limit 1;
        on vote when has_sample($c_$m_vote) reject "That model already voted on that case.";
        on vote sample $c_$m_vote = verdict;
        # A vote counts while it says yes and has not been withdrawn.
        define $c_$m_yes = has_sample($c_$m_vote) and latest($c_$m_vote) == 1
            and not withdrawn(latest($c_$m_vote));
    };
};

for case as $c routed by case {
    decisions $c_approve limit 2;
    define $c_yes = if($c_m1_yes, 1, 0) + if($c_m2_yes, 1, 0) + if($c_m3_yes, 1, 0);
    on decide when committed($c_approve) and not reopened($c_approve) reject "Already decided.";
    on decide when $c_yes < 2 reject "Fewer than two models agree.";
    # One rule per set of agreeing models. A rule's condition does not ground
    # the decision; its `using` does, so the grounds hold exactly the votes
    # that agreed. (`using if($c_m1_yes, ...)` would ground it on every vote
    # the condition reads, the dissenting ones included.)
    on decide when $c_m1_yes and $c_m2_yes and $c_m3_yes
        commit $c_approve because enough using latest($c_m1_vote) + latest($c_m2_vote) + latest($c_m3_vote);
    on decide when $c_m1_yes and $c_m2_yes and not $c_m3_yes
        commit $c_approve because enough using latest($c_m1_vote) + latest($c_m2_vote);
    on decide when $c_m1_yes and not $c_m2_yes and $c_m3_yes
        commit $c_approve because enough using latest($c_m1_vote) + latest($c_m3_vote);
    on decide when not $c_m1_yes and $c_m2_yes and $c_m3_yes
        commit $c_approve because enough using latest($c_m2_vote) + latest($c_m3_vote);

    bind $c.approval = "undecided";
    bind $c.approval = "approved" when committed($c_approve) and not reopened($c_approve);
    bind $c.approval = "holds without the withdrawn vote"
        when committed($c_approve) and not reopened($c_approve) and rests_on_withdrawn($c_approve);
    bind $c.approval = "reopened: a withdrawn vote tipped it" when reopened($c_approve);
};

# Finding a model unreliable withdraws every vote it cast, on every case.
for model as $m routed by model {
    on distrust when observed($m_bad) reject "Already found unreliable.";
    on distrust reveal $m_bad;
    on distrust withdraw every $m_out because $m_bad;
    for case as $c {
        on distrust when committed($c_approve) and not reopened($c_approve)
            and rests_on_withdrawn($c_approve) and $c_yes < 2
            reopen $c_approve because $m_bad;
    };
};
