scene "Sample 002: departure continuation, recorded during the 2026-10-07 takeover. Earlier private d002-log.md was not supplied.";
claim recoverable;
claim restore_correct;
claim ready;
evidence saved_commit from "GitHub commit 7f551e5774d61ec9f88e0d603e5b01196597b00c fetched into codex/rc16-continuation";
evidence handoff from "Owner-supplied STATUS.md, 2026-10-05: immediate restore after withdrawal cascade is unfinished";
evidence owner_go from "Owner in this chat, 2026-10-07: proceed to work on everything discussed";
evidence failing_regression from "runtime/tests/departure.rs: immediate-save regression refused retired a_reason@2 as pinned by nothing before the fix";
evidence focused_checks from "runtime/tests/departure.rs: focused cascade, pin multiplicity, restore, and atomic rollback tests after the fix; see development receipts";
evidence full_checks from "Reserved for completed native, WebAssembly, kit, browser and CI checks on the reviewed revision; not observed by the live event log yet";
evidence regression_returns from "Counterfactual only: a later check invalidates the focused result";
caveat full_checks_pending consequence high;
caveat archive_contract_open consequence material;
decisions implementation limit 2;
decisions readiness limit 2;
event recover; event authorize; event reproduce; event focused_pass; event begin;
event verify; event finish; event invalidate;
on recover reveal saved_commit supports recoverable;
on recover reveal handoff;
on authorize reveal owner_go;
on reproduce reveal failing_regression opposes restore_correct;
on focused_pass reveal focused_checks supports restore_correct;
on begin when not observed(failing_regression) reject "Reproduce the reported failure before accepting a fix direction.";
on begin commit implementation because enough using qualified(1, saved_commit)
  permitted by owner_go retaining full_checks_pending, archive_contract_open;
on verify reveal full_checks supports ready;
on finish when not observed(full_checks) reject "Focused results do not establish full readiness.";
on finish commit readiness because enough using qualified(1, full_checks) permitted by owner_go;
on invalidate reveal regression_returns opposes restore_correct;
on invalidate withdraw focused_checks because regression_returns;
bind work.started = committed(implementation);
bind work.ready = committed(readiness);
bind checks.withdrawn = withdrawn(focused_checks);
