{
  "schema": "caveat-scenarios/0.1",
  "source": "release.cav",
  "scenarios": [
    {
      "id": "R01",
      "title": "Stale green: a pull request that passed on an old base does not make main tested, and readiness waits for main's own run",
      "steps": [
        {
          "send": "opened",
          "payload": {
            "commit": "3a26d1c7a2f2db3d8051c152fe8646fdd8fd4580"
          }
        },
        {
          "send": "pr_run",
          "payload": {
            "target": "pr2",
            "head": "2499b103574ff89169d09d3330e754de231038c6",
            "base": "3a26d1c7a2f2db3d8051c152fe8646fdd8fd4580",
            "result": "passed"
          }
        },
        {
          "send": "pr_run",
          "payload": {
            "target": "pr3",
            "head": "2ea193e61a693a02dd74b65f147f778ac0e5200b",
            "base": "3a26d1c7a2f2db3d8051c152fe8646fdd8fd4580",
            "result": "passed"
          }
        },
        {
          "expect": {
            "/bindings/pr2/status": "passing",
            "/bindings/pr3/status": "passing",
            "/binding_qualifications/pr3/status/caveats": []
          },
          "note": "Both ran on main's head."
        },
        {
          "send": "merged",
          "payload": {
            "target": "pr2",
            "head": "2499b103574ff89169d09d3330e754de231038c6",
            "commit": "c2526b83e77e36f3a577b75b15a1beec7cf5b4ff"
          }
        },
        {
          "expect": {
            "/bindings/repo/main_status": "tested by a pull request's run; no candidate built",
            "/bindings/pr3/status": "passing on a stale base",
            "/binding_qualifications/pr3/status/caveats": [
              "stale_base"
            ],
            "/relations": {
              "$includes": [
                {
                  "from": "stale_base",
                  "relation": "qualifies",
                  "to": "pr3_ci",
                  "origin": "live"
                }
              ]
            }
          },
          "note": "pr2 merged exactly what its run tested; pr3's run now measured an old base."
        },
        {
          "send": "merged",
          "payload": {
            "target": "pr3",
            "head": "2ea193e61a693a02dd74b65f147f778ac0e5200b",
            "commit": "64f85095c7f77bb6aa31888cff62b382ae3e59f2"
          }
        },
        {
          "expect": {
            "/bindings/repo/main_status": "no passing run on main's head",
            "/bindings/pr3/status": "merged"
          }
        },
        {
          "send": "decide",
          "rejected": "No passing Runtime run on main's head."
        },
        {
          "send": "main_run",
          "payload": {
            "commit": "c2526b83e77e36f3a577b75b15a1beec7cf5b4ff",
            "result": "passed"
          },
          "rejected": "A run for a commit that is not main's head."
        },
        {
          "send": "main_run",
          "payload": {
            "commit": "64f85095c7f77bb6aa31888cff62b382ae3e59f2",
            "result": "passed"
          }
        },
        {
          "send": "decide"
        },
        {
          "expect": {
            "/bindings/repo/release": "publishable",
            "/commitment_grounds/ready@1": {
              "evidence": [
                "main_runs@1"
              ],
              "caveats": []
            }
          },
          "note": "Readiness rests on main's own run, never on a pull request's."
        },
        {
          "send": "decide",
          "rejected": "Already decided publishable."
        }
      ]
    },
    {
      "id": "R02",
      "title": "A rerun on the current base clears the stale caveat; merging it leaves main tested by that run",
      "steps": [
        {
          "send": "opened",
          "payload": {
            "commit": "3a26d1c7a2f2db3d8051c152fe8646fdd8fd4580"
          }
        },
        {
          "send": "pr_run",
          "payload": {
            "target": "pr3",
            "head": "2ea193e61a693a02dd74b65f147f778ac0e5200b",
            "base": "3a26d1c7a2f2db3d8051c152fe8646fdd8fd4580",
            "result": "passed"
          }
        },
        {
          "send": "merged",
          "payload": {
            "target": "unlisted",
            "head": "2499b103574ff89169d09d3330e754de231038c6",
            "commit": "c2526b83e77e36f3a577b75b15a1beec7cf5b4ff"
          }
        },
        {
          "expect": {
            "/bindings/pr3/status": "passing on a stale base"
          }
        },
        {
          "send": "pr_run",
          "payload": {
            "target": "pr3",
            "head": "eab674bafb95d82534a8ce249ca3999c897e4451",
            "base": "c2526b83e77e36f3a577b75b15a1beec7cf5b4ff",
            "result": "passed"
          }
        },
        {
          "expect": {
            "/bindings/pr3/status": "passing",
            "/relations": {
              "$set": [
                {
                  "from": "pr3_ci",
                  "relation": "supports",
                  "to": "publishable",
                  "origin": "live"
                },
                {
                  "from": "stale_base",
                  "relation": "qualifies",
                  "to": "pr3_ci",
                  "origin": "live"
                },
                {
                  "from": "pr3_ci@2",
                  "relation": "supports",
                  "to": "publishable",
                  "origin": "live"
                }
              ]
            }
          },
          "note": "A new run is a new occurrence, pr3_ci@2, without the old one's caveat. The old run keeps it."
        },
        {
          "send": "merged",
          "payload": {
            "target": "pr3",
            "head": "2ea193e61a693a02dd74b65f147f778ac0e5200b",
            "commit": "64f85095c7f77bb6aa31888cff62b382ae3e59f2"
          }
        },
        {
          "expect": {
            "/bindings/repo/main_status": "no passing run on main's head"
          },
          "note": "It merged a head other than the one its last run tested."
        },
        {
          "send": "pr_run",
          "payload": {
            "target": "pr3",
            "head": "eab674bafb95d82534a8ce249ca3999c897e4451",
            "base": "64f85095c7f77bb6aa31888cff62b382ae3e59f2",
            "result": "passed"
          },
          "rejected": "The pull request is already merged."
        }
      ]
    },
