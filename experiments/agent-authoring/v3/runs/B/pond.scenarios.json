{
  "schema": "caveat-scenarios/0.1",
  "source": "pond.cav",
  "scenarios": [
    {
      "id": "P01",
      "title": "Initial display before anything happens",
      "steps": [
        { "expect": {
            "/sequence": 0,
            "/bindings/hud": { "$exact": { "readings": 0, "thinnest": -1, "cracked": 0, "decision": "none", "frozen": -1, "revision": 0 } },
            "/bindings": { "$exact": { "hud": { "readings": 0, "thinnest": -1, "cracked": 0, "decision": "none", "frozen": -1, "revision": 0 } } },
            "/decision_journal": [],
            "/commitment_grounds": { "$exact": {} }
        } }
      ]
    },
    {
      "id": "P02",
      "title": "Readings carry single_hole, support or oppose ice_safe, and the thinnest is tracked",
      "steps": [
        { "send": "measure", "payload": { "cm": 12 } },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 1, "thinnest": 12, "cracked": 0, "decision": "none", "frozen": -1, "revision": 0 } },
            "/reading_streams/thickness/template": "auger",
            "/reading_streams/thickness/limit": 8,
            "/reading_streams/thickness/occurrences/0": { "id": "thickness@1", "value": 12, "relation": "supports", "claim": "ice_safe",
               "provenance": { "evidence": ["thickness@1"], "caveats": ["single_hole"] } }
        } },
        { "send": "measure", "payload": { "cm": 9.5 } },
        { "send": "measure", "payload": { "cm": 10 } },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 3, "thinnest": 9.5, "cracked": 0, "decision": "none", "frozen": -1, "revision": 0 } },
            "/reading_streams/thickness/occurrences/1": { "id": "thickness@2", "value": 9.5, "relation": "opposes", "claim": "ice_safe",
               "provenance": { "evidence": ["thickness@2"], "caveats": ["single_hole"] } },
            "/reading_streams/thickness/occurrences/2": { "id": "thickness@3", "value": 10, "relation": "supports", "claim": "ice_safe" },
            "/relations": { "$includes": [
              { "from": "thickness@1", "relation": "supports", "to": "ice_safe", "origin": "live" },
              { "from": "thickness@2", "relation": "opposes", "to": "ice_safe", "origin": "live" },
              { "from": "thickness@3", "relation": "supports", "to": "ice_safe", "origin": "live" },
              { "from": "single_hole", "relation": "qualifies", "to": "thickness@1", "origin": "live" },
              { "from": "single_hole", "relation": "qualifies", "to": "thickness@2", "origin": "live" },
              { "from": "single_hole", "relation": "qualifies", "to": "thickness@3", "origin": "live" }
            ] }
        } }
      ]
    },
    {
      "id": "P03",
      "title": "At most eight measurements; the ninth is refused and changes nothing",
      "steps": [
        { "send": "measure", "payload": { "cm": 30 }, "repeat": 8 },
        { "expect": { "/bindings/hud/readings": 8, "/sequence": 8 } },
        { "send": "measure", "payload": { "cm": 5 }, "rejected": true },
        { "send": "measure", "payload": { "cm": 50 }, "rejected": true },
        { "expect": { "/bindings/hud/readings": 8, "/bindings/hud/thinnest": 30, "/sequence": 8 } },
        { "send": "decide" },
        { "expect": { "/bindings/hud": { "$exact": { "readings": 8, "thinnest": 30, "cracked": 0, "decision": "open", "frozen": 30, "revision": 1 } },
                      "/commitment_grounds/rink@1": { "$exact": { "evidence": ["thickness@1", "thickness@2", "thickness@3", "thickness@4", "thickness@5", "thickness@6", "thickness@7", "thickness@8"], "caveats": ["single_hole"] } } } },
        { "resume": true },
        { "send": "measure", "payload": { "cm": 5 }, "rejected": true }
      ]
    },
    {
      "id": "P04",
      "title": "Malformed and out-of-range events are refused by the core",
      "steps": [
        { "send": "measure", "payload": { "cm": -0.5 }, "rejected": { "origin": "input", "code": "bound_exceeded" } },
        { "send": "measure", "payload": { "cm": 60.01 }, "rejected": { "origin": "input", "code": "bound_exceeded" } },
        { "send": "measure", "rejected": { "origin": "input", "code": "payload_invalid" } },
        { "send": "measure", "payload": { "cm": 12, "depth": 3 }, "rejected": { "origin": "input", "code": "payload_invalid" } },
        { "send": "measure", "payload": { "thickness": 12 }, "rejected": { "origin": "input", "code": "payload_invalid" } },
        { "send": "measure", "payload": { "cm": "12" }, "rejected": { "origin": "input" } },
        { "send": "measure", "payload": { "cm": null }, "rejected": { "origin": "input" } },
        { "send": "measure", "payload": [12], "rejected": { "origin": "input" } },
        { "send": "crack", "payload": { "cm": 1 }, "rejected": { "origin": "input", "code": "payload_invalid" } },
        { "send": "decide", "payload": { "now": 1 }, "rejected": { "origin": "input", "code": "payload_invalid" } },
        { "send": "thaw", "rejected": { "origin": "input", "code": "unknown_event" } },
        { "send": "Measure", "payload": { "cm": 12 }, "rejected": { "origin": "input", "code": "unknown_event" } },
        { "expect": { "/sequence": 0, "/bindings/hud/readings": 0, "/decision_journal": [] } },
        { "send": "measure", "payload": { "cm": 0 } },
        { "send": "measure", "payload": { "cm": 60 } },
        { "expect": { "/sequence": 2, "/bindings/hud/readings": 2, "/bindings/hud/thinnest": 0 } }
      ]
    },
    {
      "id": "P05",
      "title": "decide needs three measurements and no decision in force",
      "steps": [
        { "send": "decide", "rejected": true },
        { "send": "measure", "payload": { "cm": 14 } },
        { "send": "measure", "payload": { "cm": 13 } },
        { "send": "decide", "rejected": true },
        { "expect": { "/sequence": 2, "/bindings/hud/decision": "none", "/bindings/hud/revision": 0 } },
        { "send": "measure", "payload": { "cm": 16 } },
        { "send": "decide" },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 3, "thinnest": 13, "cracked": 0, "decision": "open", "frozen": 13, "revision": 1 } },
            "/decision_series/rink/limit": 3,
            "/decision_series/rink/current": "rink@1",
            "/commitment_grounds/rink@1": { "$exact": { "evidence": ["thickness@1", "thickness@2", "thickness@3"], "caveats": ["single_hole"] } },
            "/decision_journal": [
              { "decision": "rink", "commitment": "rink@1", "change": "committed", "event": "decide", "value": 13,
                "because": ["thickness@1", "thickness@2", "thickness@3"], "caveats": ["single_hole"] }
            ]
        } },
        { "send": "decide", "rejected": true },
        { "send": "measure", "payload": { "cm": 12 } },
        { "send": "decide", "rejected": true },
        { "expect": { "/bindings/hud/decision": "open", "/bindings/hud/frozen": 13, "/bindings/hud/thinnest": 12, "/bindings/hud/revision": 1 } }
      ]
    },
    {
      "id": "P06",
      "title": "A thin reading reopens an open rink because of that reading; the next decision closes it for good",
      "steps": [
        { "send": "measure", "payload": { "cm": 20 } },
        { "send": "measure", "payload": { "cm": 15 } },
        { "send": "measure", "payload": { "cm": 18 } },
        { "send": "decide" },
        { "checkpoint": "first" },
        { "send": "measure", "payload": { "cm": 12 } },
        { "expect": { "/bindings/hud/decision": "open", "/decision_journal/1": { "$absent": true } } },
        { "send": "measure", "payload": { "cm": 8.5 } },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 5, "thinnest": 8.5, "cracked": 0, "decision": "review", "frozen": 15, "revision": 1 } },
            "/decision_journal/1": { "$exact": { "decision": "rink", "commitment": "rink@1", "change": "reopened", "sequence": 6, "event": "measure",
                                    "elapsed": 0, "value": 15, "because": ["thickness@5"], "caveats": ["single_hole"] } }
        } },
        { "resume": true },
        { "send": "measure", "payload": { "cm": 3 } },
        { "send": "crack" },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 6, "thinnest": 3, "cracked": 1, "decision": "review", "frozen": 15, "revision": 1 } },
            "/decision_journal/2": { "$absent": true }
        } },
        { "same_as": "first", "paths": ["/commitment_grounds/rink@1", "/commitment_bases/rink@1", "/decision_journal/0"] },
        { "send": "decide" },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 6, "thinnest": 3, "cracked": 1, "decision": "closed", "frozen": 3, "revision": 2 } },
            "/commitment_grounds/rink@2": { "$exact": { "evidence": ["thickness@1", "thickness@2", "thickness@3", "thickness@4", "thickness@5", "thickness@6"], "caveats": ["single_hole"] } },
            "/decision_journal/2": { "commitment": "rink@2", "change": "committed", "value": 3,
                                    "because": ["thickness@1", "thickness@2", "thickness@3", "thickness@4", "thickness@5", "thickness@6"], "caveats": ["single_hole"] }
        } },
        { "checkpoint": "closed" },
        { "send": "measure", "payload": { "cm": 1 } },
        { "send": "measure", "payload": { "cm": 40 } },
        { "send": "decide", "rejected": "The current decision is still in force." },
        { "send": "measure", "payload": { "cm": 40 }, "rejected": true },
        { "expect": { "/bindings/hud": { "$exact": { "readings": 8, "thinnest": 1, "cracked": 1, "decision": "closed", "frozen": 3, "revision": 2 } } } },
        { "same_as": "closed", "paths": ["/decision_journal", "/decision_series/rink/current"] }
      ]
    },
    {
      "id": "P07",
      "title": "A crack reopens an open rink because of crack_report; it is not part of the next decision's grounds",
      "steps": [
        { "send": "measure", "payload": { "cm": 12 } },
        { "send": "measure", "payload": { "cm": 11 } },
        { "send": "measure", "payload": { "cm": 14 } },
        { "send": "decide" },
        { "send": "crack" },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 3, "thinnest": 11, "cracked": 1, "decision": "review", "frozen": 11, "revision": 1 } },
            "/decision_journal/1": { "$exact": { "decision": "rink", "commitment": "rink@1", "change": "reopened", "sequence": 5, "event": "crack",
                                    "elapsed": 0, "value": 11, "because": ["crack_report"], "caveats": ["secondhand"] } },
            "/relations": { "$includes": [ { "from": "crack_report", "relation": "opposes", "to": "ice_safe", "origin": "live" } ] }
        } },
        { "send": "crack", "rejected": "A crack has already been reported." },
        { "send": "measure", "payload": { "cm": 9 } },
        { "expect": { "/decision_journal/2": { "$absent": true }, "/bindings/hud/decision": "review" } },
        { "resume": true },
        { "send": "decide" },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 4, "thinnest": 9, "cracked": 1, "decision": "closed", "frozen": 9, "revision": 2 } },
            "/commitment_grounds/rink@2": { "$exact": { "evidence": ["thickness@1", "thickness@2", "thickness@3", "thickness@4"], "caveats": ["single_hole"] } }
        } }
      ]
    },
    {
      "id": "P08",
      "title": "Three decisions: open, crack reopens, open again, thin reading reopens, closed",
      "steps": [
        { "send": "measure", "payload": { "cm": 25 } },
        { "send": "measure", "payload": { "cm": 22.5 } },
        { "send": "measure", "payload": { "cm": 30 } },
        { "send": "decide" },
        { "send": "crack" },
        { "send": "decide" },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 3, "thinnest": 22.5, "cracked": 1, "decision": "open", "frozen": 22.5, "revision": 2 } },
            "/commitment_grounds/rink@2": { "$exact": { "evidence": ["thickness@1", "thickness@2", "thickness@3"], "caveats": ["single_hole"] } }
        } },
        { "send": "decide", "rejected": true },
        { "send": "crack", "rejected": true },
        { "send": "measure", "payload": { "cm": 10 } },
        { "expect": { "/bindings/hud/decision": "open", "/bindings/hud/thinnest": 10 } },
        { "send": "measure", "payload": { "cm": 9.99 } },
        { "expect": { "/bindings/hud/decision": "review", "/bindings/hud/frozen": 22.5 } },
        { "resume": true },
        { "send": "decide" },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 5, "thinnest": 9.99, "cracked": 1, "decision": "closed", "frozen": 9.99, "revision": 3 } },
            "/decision_series/rink/current": "rink@3",
            "/decision_journal": [
              { "commitment": "rink@1", "change": "committed", "value": 22.5, "because": ["thickness@1", "thickness@2", "thickness@3"], "caveats": ["single_hole"] },
              { "commitment": "rink@1", "change": "reopened", "because": ["crack_report"], "caveats": ["secondhand"] },
              { "commitment": "rink@2", "change": "committed", "value": 22.5, "because": ["thickness@1", "thickness@2", "thickness@3"], "caveats": ["single_hole"] },
              { "commitment": "rink@2", "change": "reopened", "because": ["thickness@5"], "caveats": ["single_hole"] },
              { "commitment": "rink@3", "change": "committed", "value": 9.99, "because": ["thickness@1", "thickness@2", "thickness@3", "thickness@4", "thickness@5"], "caveats": ["single_hole"] }
            ],
            "/commitment_grounds/rink@3": { "$exact": { "evidence": ["thickness@1", "thickness@2", "thickness@3", "thickness@4", "thickness@5"], "caveats": ["single_hole"] } }
        } },
        { "send": "decide", "rejected": true },
        { "send": "measure", "payload": { "cm": 2 } },
        { "expect": { "/decision_journal/5": { "$absent": true }, "/bindings/hud/decision": "closed" } }
      ]
    },
    {
      "id": "P09",
      "title": "A closed decision is never reopened, by a crack or a thin reading",
      "steps": [
        { "send": "measure", "payload": { "cm": 8 } },
        { "send": "measure", "payload": { "cm": 20 } },
        { "send": "measure", "payload": { "cm": 20 } },
        { "send": "decide" },
        { "expect": { "/bindings/hud": { "$exact": { "readings": 3, "thinnest": 8, "cracked": 0, "decision": "closed", "frozen": 8, "revision": 1 } } } },
        { "send": "crack" },
        { "send": "measure", "payload": { "cm": 4 } },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 4, "thinnest": 4, "cracked": 1, "decision": "closed", "frozen": 8, "revision": 1 } },
            "/decision_journal": [ { "commitment": "rink@1", "change": "committed" } ]
        } },
        { "send": "decide", "rejected": true }
      ]
    },
    {
      "id": "P10",
      "title": "A crack before any decision is recorded but reopens nothing and is not in the grounds",
      "steps": [
        { "send": "crack" },
        { "expect": { "/bindings/hud": { "$exact": { "readings": 0, "thinnest": -1, "cracked": 1, "decision": "none", "frozen": -1, "revision": 0 } } } },
        { "resume": true },
        { "send": "crack", "rejected": true },
        { "send": "measure", "payload": { "cm": 10 } },
        { "send": "measure", "payload": { "cm": 10 } },
        { "send": "measure", "payload": { "cm": 10 } },
        { "send": "decide" },
        { "expect": {
            "/bindings/hud": { "$exact": { "readings": 3, "thinnest": 10, "cracked": 1, "decision": "open", "frozen": 10, "revision": 1 } },
            "/commitment_grounds/rink@1": { "$exact": { "evidence": ["thickness@1", "thickness@2", "thickness@3"], "caveats": ["single_hole"] } },
            "/decision_journal": [ { "commitment": "rink@1", "change": "committed", "value": 10, "because": ["thickness@1", "thickness@2", "thickness@3"], "caveats": ["single_hole"] } ]
        } },
        { "send": "measure", "payload": { "cm": 0 } },
        { "expect": { "/bindings/hud/decision": "review", "/decision_journal/1": { "change": "reopened", "because": ["thickness@4"] } } }
      ]
    }
  ]
}
