     "payload": {
      "kt": 1
     }
    },
    {
     "send": "gust",
     "payload": {
      "kt": 2
     }
    },
    {
     "send": "wave",
     "payload": {
      "m": 1
     }
    },
    {
     "send": "wave",
     "payload": {
      "m": 1
     }
    },
    {
     "send": "decide"
    },
    {
     "send": "wave",
     "payload": {
      "m": 2
     }
    },
    {
     "send": "decide"
    },
    {
     "send": "wave",
     "payload": {
      "m": 2
     }
    },
    {
     "send": "decide"
    },
    {
     "send": "wave",
     "payload": {
      "m": 2
     }
    },
    {
     "send": "decide"
    },
    {
     "send": "pier_gust",
     "payload": {
      "kt": 31
     }
    },
    {
     "expect": {
      "/bindings/hud/decision": "review",
      "/bindings/hud/revision": 4
     }
    },
