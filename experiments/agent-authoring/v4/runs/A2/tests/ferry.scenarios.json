    }
   ]
  },
  {
   "id": "F10",
   "title": "Unchanged rules: ten waves, two waves before deciding, no decide while in force, mast-only grounds",
   "steps": [
    {
     "send": "gust",
     "payload": {
      "kt": 20
     }
    },
    {
     "send": "gust",
     "payload": {
      "kt": 12
     }
    },
    {
     "send": "wave",
     "payload": {
      "m": 0.2
     }
    },
    {
     "send": "decide",
     "rejected": "At least two waves must be recorded before deciding."
    },
    {
     "send": "wave",
     "payload": {
      "m": 6
     }
    },
    {
     "send": "decide"
    },
    {
     "expect": {
      "/bindings/hud/decision": "go",
      "/bindings/hud/frozen": 20,
      "/bindings/hud/highest": 6,
      "/commitment_grounds/crossing@1": {
       "evidence": [
        "wind@1",
        "wind@2"
       ],
       "caveats": [
        "sheltered_mast"
       ]
      }
     }
    },
    {
     "send": "decide",
     "rejected": "A decision is in force; it must be reopened before deciding again."
    },
    {
     "send": "wave",
     "payload": {
      "m": 1
     },
     "repeat": 8
    },
    {
     "send": "wave",
     "payload": {
      "m": 1
     },
     "rejected": "Ten waves have already been recorded."
    },
    {
     "send": "wave",
     "payload": {
      "m": 6.01
     },
     "rejected": {
      "origin": "input",
      "code": "bound_exceeded"
     }
    },
    {
     "expect": {
      "/bindings/hud": {
       "$exact": {
        "gusts": 2,
        "pier_gusts": 0,
        "waves": 10,
        "strongest": 20,
        "highest": 6,
        "warned": 0,
        "decision": "go",
        "frozen": 20,
        "revision": 1
       }
      }
     }
    }
   ]
  }
 ]
