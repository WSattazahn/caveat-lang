claim access_allowed;
claim review_required;
evidence alpha_allow from "alpha allows access";
evidence beta_allow from "beta allows access";
evidence alpha_deny from "alpha denies access";
evidence beta_deny from "beta denies access";
evidence challenge from "access review challenge";
caveat unverified_source consequence material;
caveat expired consequence material;
caveat revoked consequence material;
unverified_source qualifies alpha_allow;
unverified_source qualifies beta_allow;
unverified_source qualifies alpha_deny;
unverified_source qualifies beta_deny;

decisions access limit 3;
state clock_high = 0 min 0 max 17179869184;
state clock_low = 0 min 0 max 1048576;
state next_high = 0 min 0 max 17179869184;
define elapsed = clock_high * 1048576 + clock_low;
state support = 0 min 0 max 2;
state opposition = 0 min 0 max 2;
state revision = 0 min 0 max 3;

event submit code min 1 max 5;
event revoke code min 1 max 4;
event approve;
event advance dt min 0 max 2;
clock advance every 1;

proc tally() {
    set support = 0;
    set opposition = 0;
    when observed(alpha_allow) and not carries(alpha_allow, expired) and not carries(alpha_allow, revoked)
        set support = support + qualified(1, alpha_allow);
    when observed(beta_allow) and not carries(beta_allow, expired) and not carries(beta_allow, revoked)
        set support = support + qualified(1, beta_allow);
    when observed(alpha_deny) and not carries(alpha_deny, expired) and not carries(alpha_deny, revoked)
        set opposition = opposition + qualified(1, alpha_deny);
    when observed(beta_deny) and not carries(beta_deny, expired) and not carries(beta_deny, revoked)
        set opposition = opposition + qualified(1, beta_deny);
};

on submit when code != floor(code) reject "code must be an integer";
on submit when code == 1 and observed(alpha_allow) reject "already submitted";
on submit when code == 2 and observed(beta_allow) reject "already submitted";
on submit when code == 3 and observed(alpha_deny) reject "already submitted";
on submit when code == 4 and observed(beta_deny) reject "already submitted";
on submit when code == 5 and observed(challenge) reject "already submitted";
on submit when code == 1 reveal alpha_allow supports access_allowed;
on submit when code == 2 reveal beta_allow supports access_allowed;
on submit when code == 3 reveal alpha_deny opposes access_allowed;
on submit when code == 4 reveal beta_deny opposes access_allowed;
on submit when code == 5 reveal challenge supports review_required;
on submit when code == 1 qualify alpha_allow with expired after 2;
on submit when code == 2 qualify beta_allow with expired after 2;
on submit when code == 3 qualify alpha_deny with expired after 2;
on submit when code == 4 qualify beta_deny with expired after 2;
on submit when code == 3 and committed(access) reopen access because alpha_deny;
on submit when code == 4 and committed(access) reopen access because beta_deny;
on submit when code == 5 and committed(access) reopen access because challenge;
on submit call tally();

on revoke when code != floor(code) reject "code must be an integer";
on revoke when code == 1 and not observed(alpha_allow) reject "assertion not observed";
on revoke when code == 2 and not observed(beta_allow) reject "assertion not observed";
on revoke when code == 3 and not observed(alpha_deny) reject "assertion not observed";
on revoke when code == 4 and not observed(beta_deny) reject "assertion not observed";
on revoke when code == 1 and carries(alpha_allow, revoked) reject "already revoked";
on revoke when code == 2 and carries(beta_allow, revoked) reject "already revoked";
on revoke when code == 3 and carries(alpha_deny, revoked) reject "already revoked";
on revoke when code == 4 and carries(beta_deny, revoked) reject "already revoked";
on revoke when code == 1 qualify alpha_allow with revoked;
on revoke when code == 2 qualify beta_allow with revoked;
on revoke when code == 3 qualify alpha_deny with revoked;
on revoke when code == 4 qualify beta_deny with revoked;
on revoke call tally();

on approve when support + opposition == 0 reject "no active votes";
on approve when committed(access) and not reopened(access) reject "decision is closed";
on approve commit access because enough using if(support > opposition, 1, 0);
on approve set revision = revision + 1;

on advance set next_high = floor((elapsed + dt) / 1048576);
on advance set clock_low = elapsed + dt - next_high * 1048576;
on advance set clock_high = next_high;
on advance call tally();

bind hud.support = support;
bind hud.opposition = opposition;
bind hud.verdict = "undecided";
bind hud.verdict = "deny" when support + opposition > 0;
bind hud.verdict = "allow" when support > opposition;
bind hud.decision = "none";
bind hud.decision = "deny" when committed(access) and latest(access) == 0;
bind hud.decision = "allow" when committed(access) and latest(access) == 1;
bind hud.decision = "review" when reopened(access);
bind hud.frozen = if(committed(access), latest(access), -1);
bind hud.revision = revision;
bind hud.elapsed = elapsed;

