# Vessel pins the sha256 of built Caveat artifacts.
#
# scripts/build-web.mjs copies working-tree bytes straight into dist/, and the
# Vessel provenance check (scripts/syncSlimeGlowCaveat.mjs in GPT_SandBox_Web)
# compares dist/slime_glow_ability.cav and dist/slime-glow-policy.js against
# examples/slime_glow_ability.cav, web/slime-glow-policy.js and the committed
# blobs, then against the sha256 values recorded in
# public/caveat/slime-glow/receipt.json.
#
# Git for Windows installs core.autocrlf=true by default, which would check
# these files out with CRLF and silently change every one of those hashes. Pin
# LF in the working tree on every platform so a checkout can never alter the
# bytes we publish.
* text=auto eol=lf

# The hashed and pinned families, stated explicitly so the guarantee survives
# any future edit to the wildcard above.
*.cav   text eol=lf
*.cvr   text eol=lf
*.ebnf  text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.md    text eol=lf
*.mjs   text eol=lf
*.rs    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf

# Binary payloads must never pass through the text filter.
*.wasm binary
*.png  binary
*.webp binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.mp3  binary
*.ogg  binary
*.wav  binary
*.mp4  binary

# Frozen measurement receipts retain the observed bytes (including Windows
# log/JSON line endings) so their published SHA-256 values survive checkout.
experiments/departure-gate/collector-results/** -text whitespace=cr-at-eol
# Terminal receipts also keep their original trailing blank output lines.
experiments/departure-gate/collector-results/**/*.log whitespace=cr-at-eol,-blank-at-eof

# Frozen index-compaction observations retain their recorded bytes.
experiments/departure-gate/index-compaction/results/** -text whitespace=cr-at-eol

# Keep the independently authored regression body byte-exact for its provenance self-check.
experiments/departure-gate/withdrawal-batch/independent-wasm-check.mjs -text

# Preserve the recorded withdrawal-extraction observations and stream hashes.
experiments/departure-gate/withdrawal-batch/results/** -text whitespace=cr-at-eol,-blank-at-eof

# Frozen release-preparation observations preserve their original bytes.
experiments/departure-gate/release-evidence/** -text whitespace=cr-at-eol,-blank-at-eof
