claim seen;
evidence a from "synthetic a"; renewable a window 1;
evidence sample_source from "retained computation";
readings kept from sample_source window 1;
caveat stale consequence material;
state result = 0;
event initialize; event cycle; event probe; event replace; event clear;
on initialize renew a;
on initialize reveal a supports seen;
on initialize qualify a with stale;
on initialize sample kept = qualified(1,a) supports seen;
on initialize withdraw a because a;
on cycle renew a;
on cycle reveal a supports seen;
on cycle withdraw a because a;
on probe set result = latest(kept);
on clear set result = 0;
on replace sample kept = 0 supports seen;
bind hud.withdrawn = has_caveat(result,withdrawn);
bind hud.stale = has_caveat(result,stale);
