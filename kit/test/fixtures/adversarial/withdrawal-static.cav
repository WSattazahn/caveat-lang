claim seen;
evidence subject from "synthetic subject";
evidence reason from "first synthetic reason";
evidence second from "second synthetic reason";
evidence unseen from "deliberately unobserved";
caveat stale consequence material;
state reason_read = 0;
state divisor = 1;
event setup;
event pull;
event repeat;
event noop;
event dormant;
event unobserved_subject;
event unobserved_reason;
event observe_unseen;
event read_reason;
event refuse;
event fail;
on setup reveal subject supports seen;
on setup reveal reason supports seen;
on setup reveal second supports seen;
on setup qualify reason with stale;
on pull withdraw subject because reason;
on repeat withdraw subject because second;
on dormant when 0 == 1 withdraw subject because second;
on unobserved_subject withdraw unseen because reason;
on unobserved_reason withdraw subject because unseen;
on observe_unseen reveal unseen supports seen;
on read_reason set reason_read = if(withdrawn(subject),1,0);
on refuse withdraw subject because reason;
on refuse reject "synthetic policy refusal";
on fail withdraw subject because reason;
on fail set divisor = 0;
bind hud.guard = 1 / divisor;
bind hud.withdrawn = withdrawn(subject);
