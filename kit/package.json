{
  "name": "caveat-lang",
  "version": "0.1.0-rc.16",
  "mcpName": "io.github.WSattazahn/caveat-lang",
  "description": "CAVEAT Language — a decision ledger for agents. An embeddable decision runtime with a small rules language: values carry their evidence and caveats, decisions keep the grounds they were made on, and authored policies reopen them when evidence changes. Runs on WebAssembly in Node and browsers, with a Node CLI and an MCP authoring bridge.",
  "keywords": [
    "caveat",
    "programming-language",
    "reactive",
    "provenance",
    "evidence",
    "decisions",
    "explainability",
    "webassembly",
    "dsl"
  ],
  "homepage": "https://github.com/WSattazahn/caveat-lang/tree/main/kit#readme",
  "bugs": {
    "url": "https://github.com/WSattazahn/caveat-lang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WSattazahn/caveat-lang.git",
    "directory": "kit"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "caveat": "bin/caveat.mjs",
    "caveat-lang": "bin/caveat.mjs"
  },
  "exports": {
    "./session": {
      "types": "./lib/session.d.mts",
      "default": "./lib/session.mjs"
    },
    "./node": {
      "types": "./lib/node.d.mts",
      "default": "./lib/node.mjs"
    },
    "./scenarios": {
      "types": "./lib/scenarios.d.mts",
      "default": "./lib/scenarios.mjs"
    },
    "./explain": {
      "types": "./lib/explain.d.mts",
      "default": "./lib/explain.mjs"
    },
    "./serve": {
      "types": "./lib/serve.d.mts",
      "default": "./lib/serve.mjs"
    },
    "./check": {
      "types": "./lib/check.d.mts",
      "default": "./lib/check.mjs"
    },
    "./types": {
      "types": "./lib/types.d.mts",
      "default": "./lib/types.mjs"
    },
    "./starter": {
      "types": "./lib/starter.d.mts",
      "default": "./lib/starter.mjs"
    },
    "./starter/node": {
      "types": "./lib/starter-node.d.mts",
      "default": "./lib/starter-node.mjs"
    },
    "./runtime/*": "./runtime/*"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "examples/",
    "runtime/",
    "docs/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "tag": "next"
  },
  "scripts": {
    "test": "node --test"
  }
}
