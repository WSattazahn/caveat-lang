claim c;
evidence x from "x";
evidence w from "w";
evidence y from "y";
state gate = 0;
state slot = 0;
state flag = 0;
decisions d limit 3;
event first;
event see;
event retract;
event check;
on first reveal x supports c;
on first set gate = qualified(1, x);
on see when gate == 1 reveal w supports c;
proc store(v) { set slot = v; };
proc decide(v) { commit d because enough using v; };
on see call store(qualified(7, w));
on see call decide(qualified(7, w));
on retract reveal y supports c;
on retract withdraw x because y;
on check when rests_on_withdrawn(d) set flag = 1;
event again;
on again reopen d because y;
on again call store(qualified(8, w));
on again call decide(qualified(8, w));
