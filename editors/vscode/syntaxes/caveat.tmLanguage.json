{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Caveat",
  "scopeName": "source.caveat",
  "fileTypes": [
    "cav"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#for-block"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#stray-template"
    },
