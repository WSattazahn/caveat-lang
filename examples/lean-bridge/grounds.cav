# Results that rest on a Lean-checked lemma, and results that also rest on an
# unchecked one. CI checks the Lean theorem each run (lean-grounds.json,
# scripts/check-lean-grounds.mjs); when the check fails, or the theorem's
# statement changes, the host sends lean_failed and everything built on the
# lemma is reopened. A refuted unchecked lemma reopens only what used it.
# Once the proof is fixed, the next passing check observes a new occurrence of
# the lemma, and results derived again rest on that one.
claim bound_holds;

evidence lean_lemma from "lean:LeanBridgeDemo.lt_two_pow";
evidence model_lemma from "a model's proof sketch, not formalized";
evidence lean_check from "the CI check of the named Lean theorem";
evidence counterexample from "a counterexample to the model's lemma";

renewable lean_lemma limit 16;

caveat unchecked consequence material;
unchecked qualifies model_lemma;

# Rests on the Lean lemma alone.
decisions checked_result limit 4;
# Rests on the Lean lemma and the model's lemma.
decisions combined_result limit 4;

state failure = 0 min 0 max 3;

event lean_checked;
event lean_failed why in broken changed missing;
event model_claimed;
event derive;
event refute_model;

on lean_checked when withdrawn(lean_lemma) renew lean_lemma;
on lean_checked set failure = 0;
on lean_checked reveal lean_lemma supports bound_holds;
on model_claimed reveal model_lemma supports bound_holds;

on derive when not observed(lean_lemma) or withdrawn(lean_lemma) reject "No checked lemma to derive from.";
on derive when not committed(checked_result) or reopened(checked_result)
    commit checked_result because enough citing qualified(1, lean_lemma);
on derive when observed(model_lemma) and not withdrawn(model_lemma) and (not committed(combined_result) or reopened(combined_result))
    commit combined_result because enough citing qualified(1, lean_lemma), qualified(1, model_lemma);

on lean_failed when not observed(lean_lemma) or withdrawn(lean_lemma) reject "No checked lemma to withdraw.";
on lean_failed set failure = if(why == why.broken, 1, if(why == why.changed, 2, 3));
on lean_failed reveal lean_check;
on lean_failed withdraw lean_lemma because lean_check;
on lean_failed when committed(checked_result) and not reopened(checked_result) and rests_on_withdrawn(checked_result)
    reopen checked_result because lean_check;
on lean_failed when committed(combined_result) and not reopened(combined_result) and rests_on_withdrawn(combined_result)
    reopen combined_result because lean_check;

on refute_model when not observed(model_lemma) or withdrawn(model_lemma) reject "No model lemma to refute.";
on refute_model reveal counterexample;
on refute_model withdraw model_lemma because counterexample;
on refute_model when committed(combined_result) and not reopened(combined_result) and rests_on_withdrawn(combined_result)
    reopen combined_result because counterexample;

bind status.lean = "not checked";
bind status.lean = "checked" when observed(lean_lemma) and not withdrawn(lean_lemma);
bind status.lean = "proof broken" when failure == 1;
bind status.lean = "statement changed" when failure == 2;
bind status.lean = "theorem missing" when failure == 3;

bind status.checked_result = "none";
bind status.checked_result = "rests on a checked proof" when committed(checked_result);
bind status.checked_result = "reopened" when committed(checked_result) and reopened(checked_result);

bind status.combined_result = "none";
bind status.combined_result = "needs review: rests on an unchecked lemma" when committed(combined_result);
bind status.combined_result = "reopened" when committed(combined_result) and reopened(combined_result);
