{
  "schema": "caveat-scenarios/0.1",
  "source": "grounds.cav",
  "scenarios": [
    {
      "id": "L01",
      "title": "A result on a checked lemma carries no caveat; one that also uses an unchecked lemma carries it",
      "steps": [
        {
          "send": "lean_checked"
        },
        {
          "send": "model_claimed"
        },
        {
          "send": "derive"
        },
        {
          "expect": {
            "/bindings/status/lean": "checked",
            "/bindings/status/checked_result": "rests on a checked proof",
            "/bindings/status/combined_result": "needs review: rests on an unchecked lemma",
            "/commitment_grounds/checked_result@1": {
              "evidence": [
                "lean_lemma"
              ],
              "caveats": []
            },
            "/commitment_grounds/combined_result@1": {
              "evidence": {
                "$set": [
                  "lean_lemma",
                  "model_lemma"
                ]
              },
              "caveats": [
                "unchecked"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "L02",
      "title": "A changed Lean statement withdraws the lemma and reopens everything built on it",
      "steps": [
        {
          "send": "lean_checked"
        },
        {
          "send": "model_claimed"
        },
        {
          "send": "derive"
        },
        {
          "send": "lean_failed",
          "payload": {
            "why": "changed"
          }
        },
        {
          "expect": {
            "/bindings/status/lean": "statement changed",
            "/bindings/status/checked_result": "reopened",
            "/bindings/status/combined_result": "reopened"
          }
        },
        {
          "send": "derive",
          "rejected": "No checked lemma to derive from."
        }
      ]
    },
    {
      "id": "L03",
      "title": "A refuted unchecked lemma reopens only the result that used it",
      "steps": [
        {
          "send": "lean_checked"
        },
        {
          "send": "model_claimed"
        },
        {
          "send": "derive"
        },
        {
          "send": "refute_model"
        },
        {
          "expect": {
            "/bindings/status/checked_result": "rests on a checked proof",
            "/bindings/status/combined_result": "reopened"
          }
        }
      ]
    },
    {
      "id": "L04",
      "title": "A broken proof is reported as broken",
      "steps": [
        {
          "send": "lean_checked"
        },
        {
          "send": "derive"
        },
        {
          "send": "lean_failed",
          "payload": {
            "why": "broken"
          }
        },
        {
          "expect": {
            "/bindings/status/lean": "proof broken",
            "/bindings/status/checked_result": "reopened",
            "/bindings/status/combined_result": "none"
          }
        }
      ]
    },
    {
      "id": "L05",
      "title": "A fixed proof is checked again and a new result rests on the new occurrence",
      "steps": [
        {
          "send": "lean_checked"
        },
        {
          "send": "derive"
        },
        {
          "send": "lean_failed",
          "payload": {
            "why": "broken"
          }
        },
        {
          "send": "lean_checked"
        },
        {
          "send": "derive"
        },
        {
          "expect": {
            "/bindings/status/lean": "checked",
            "/bindings/status/checked_result": "rests on a checked proof",
            "/commitment_grounds/checked_result@2": {
              "evidence": [
                "lean_lemma@2"
              ],
              "caveats": []
            }
          }
        }
      ]
    },
    {
      "id": "L06",
      "title": "A lemma whose proof assumes a result for now carries the assumption into what rests on it",
      "steps": [
        {
          "send": "lean_checked"
        },
        {
          "send": "product_checked",
          "payload": {
            "assumed": 1
          }
        },
        {
          "send": "derive"
        },
        {
          "expect": {
            "/bindings/status/product": "proven, assuming a result for now",
            "/bindings/status/assumed_result": "in force",
            "/commitment_grounds/checked_result@1": {
              "evidence": [
                "lean_lemma"
              ],
              "caveats": []
            },
            "/commitment_grounds/assumed_result@1": {
              "evidence": [
                "product_lemma"
              ],
              "caveats": [
                "assumed_for_now"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "L07",
      "title": "A refuted assumption reopens what rests on the lemma that assumed it, and nothing else",
      "steps": [
        {
          "send": "lean_checked"
        },
        {
          "send": "product_checked",
          "payload": {
            "assumed": 1
          }
        },
        {
          "send": "derive"
        },
        {
          "send": "refute_assumption"
        },
        {
          "expect": {
            "/bindings/status/product": "withdrawn",
            "/bindings/status/assumed_result": "reopened",
            "/bindings/status/checked_result": "rests on a checked proof"
          }
        },
        {
          "send": "derive"
        },
        {
          "expect": {
            "/bindings/status/assumed_result": "reopened"
          }
        }
      ]
    },
    {
      "id": "L08",
      "title": "Proving the assumption takes the caveat back; an earlier result keeps what it rested on",
      "steps": [
        {
          "send": "lean_checked"
        },
        {
          "send": "product_checked",
          "payload": {
            "assumed": 1
          }
        },
        {
          "send": "derive"
        },
        {
          "send": "product_checked",
          "payload": {
            "assumed": 0
          }
        },
        {
          "expect": {
            "/bindings/status/product": "fully proven",
            "/commitment_grounds/assumed_result@1": {
              "evidence": [
                "product_lemma"
              ],
              "caveats": [
                "assumed_for_now"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "L09",
      "title": "A result derived after the assumption is proven rests on the lemma without it",
      "steps": [
        {
          "send": "lean_checked"
        },
        {
          "send": "product_checked",
          "payload": {
            "assumed": 1
          }
        },
        {
          "send": "product_checked",
          "payload": {
            "assumed": 0
          }
        },
        {
          "send": "derive"
        },
        {
          "expect": {
            "/bindings/status/product": "fully proven",
            "/commitment_grounds/assumed_result@1": {
              "evidence": [
                "product_lemma"
              ],
              "caveats": []
            }
          }
        },
        {
          "send": "refute_assumption",
          "rejected": "No lemma rests on an assumption."
        }
      ]
    }
  ]
}
