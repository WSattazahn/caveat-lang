# The Glow ability as a module: the vocabulary, the state it owns, the
# procedures that change it, and the host bindings it projects.
#
# Everything here is a declaration. The events that drive it, and the rules
# that route those events, belong to the program in slime_glow.cav.
module glow;

claim cave_entered;
claim clearing_started;
claim ruin_escaped;
claim mushroom_discovered;
claim glow_renderer_ready;
evidence cave_threshold from "Vessel's completed authored cave threshold, reported by the host";
evidence clearing_context from "Vessel's explicit free-start clearing scene profile, reported by the host";
evidence ruin_exit from "Vessel's verified inside-to-corridor-to-garden crossing of the authored ruin passage";
evidence first_mushroom from "Vessel's first authored cave mushroom absorption, reported by the host";
evidence glow_renderer from "Vessel's implemented and verified Glow renderer, reported by the host";
caveat single_absorption consequence material;
single_absorption qualifies first_mushroom;
display single_absorption "This first absorption does not establish the effects of other mushrooms.";

state learned = 0 min 0 max 1;
state active = 0 min 0 max 1;
state renderer_ready = 0 min 0 max 1;
state escaped = 0 min 0 max 1;

proc learn_glow() {
    reveal first_mushroom supports mushroom_discovered;
    set learned = qualified(1, first_mushroom);
    set active = learned * renderer_ready;
    commit keep_glow because enough using learned;
};

proc enable_glow_renderer() {
    reveal glow_renderer supports glow_renderer_ready;
    set renderer_ready = qualified(1, glow_renderer);
};

proc record_ruin_escape() {
    reveal ruin_exit supports ruin_escaped;
    set escaped = qualified(1, ruin_exit);
};

# The toggle is a procedure rather than an inline effect in the program,
# because `active` is this module's cell and a state cell is written by one
# part. See spec/caveat-0.5-draft.md section 8.
proc toggle_glow_state() {
    set active = 1 - active;
};

bind ability.name = "Mushroom discovery";
bind ability.name = "Glow" when renderer_ready == 1;
bind ability.learned = learned == 1;
bind ability.active = active == 1;
bind ability.toggleAvailable = learned == 1 and renderer_ready == 1;
bind ability.text = "Not discovered";
bind ability.text = "Mushroom absorbed" when learned == 1;
bind ability.text = "Not learned" when learned == 0 and renderer_ready == 1;
bind ability.text = if(active == 1, "Glow on", "Glow off") when learned == 1 and renderer_ready == 1;
bind item.consumed = learned == 1;
bind item.available = learned == 0;
bind objective.complete = learned == 1;
bind objective.complete = escaped == 1 when observed(clearing_context);
bind objective.text = "Find shelter in the cave.";
bind objective.text = "Absorb the cave mushroom." when observed(cave_threshold);
bind objective.text = "Mushroom absorbed." when learned == 1;
bind objective.text = "Glow learned." when learned == 1 and renderer_ready == 1;
bind objective.text = "Find a way out of the ruined room." when observed(clearing_context);
bind objective.text = "You escaped into the garden." when observed(clearing_context) and escaped == 1;
bind journal.visible = learned == 1;
bind journal.text = "";
bind journal.text = "You absorbed one mushroom. Its effects are not yet established." when learned == 1;
bind journal.text = "Your body holds the mushroom's light. You can turn Glow on and off." when learned == 1 and renderer_ready == 1;
bind journal.qualification = "This first absorption does not establish the effects of other mushrooms.";
