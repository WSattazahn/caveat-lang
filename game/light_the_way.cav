budget 8;
claim crosscurrent_mild;
claim current_eastward;
evidence morning_forecast from "tidal_archive: morning slack-water forecast";
evidence foam_sensor from "held-light foam measurement at crosscurrent_marker";
evidence weather_front from "visible cloud front and direction of surface streaks";
readings flow from foam_sensor limit 128;
readings weather from weather_front limit 8;
decisions navigation limit 128;
caveat surge_unmeasured consequence high;
caveat reading_may_age consequence high;
morning_forecast supports crosscurrent_mild;
surge_unmeasured qualifies morning_forecast;
surge_unmeasured qualifies foam_sensor;
surge_unmeasured qualifies weather_front;
reading_may_age qualifies foam_sensor;
display crosscurrent_mild "The forecast current will not materially displace the ferry.";
display current_eastward "The observed current runs eastward.";
display morning_forecast "The morning tidal record predicts mild crossflow.";
display foam_sensor "A held-light observation measures the foam's sideways motion.";
display weather_front "The surface streaks change direction; their force remains unmeasured.";
display surge_unmeasured "Storm surge may outgrow the forecast or a brief measurement.";
display reading_may_age "A measured flow may change before the crossing is complete.";
display navigation "Steer using the selected reading, retaining uncertainty about later changes.";
claim clear_course;
evidence keeper_chart from "tide_table";
keeper_chart supports clear_course;
evidence reef_one_reading from "reef_one";
caveat reef_one_shadow consequence high;
reef_one_shadow qualifies keeper_chart;
display reef_one_reading "The light reveals submerged rock.";
display reef_one_shadow "The chart may omit a submerged rock.";
evidence reef_two_reading from "reef_two";
caveat reef_two_shadow consequence high;
reef_two_shadow qualifies keeper_chart;
display reef_two_reading "The light reveals submerged rock.";
display reef_two_shadow "The chart may omit a submerged rock.";
