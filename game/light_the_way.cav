display game_title "LIGHT THE WAY";
display title "LIGHT THE WAY";
display game_subtitle "32 passengers. One light.";
display subtitle "32 passengers. One light.";
display instruction "Drag left or right. Reach the green harbor. Hold the blue ring to measure flow.";
display start_label "Start rescue";
display retry_label "Try again";
