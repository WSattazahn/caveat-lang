budget 3;
claim corridor_clear;
claim door_safe;
claim door_unsafe;
claim evacuation_route_available;
evidence camera_frame from "camera_7";
evidence latch_alarm from "latch_sensor";
evidence route_map from "evacuation_plan";
camera_frame supports corridor_clear;
latch_alarm supports door_unsafe;
route_map supports evacuation_route_available;
caveat latch_sensor_recently_serviced consequence high;
caveat camera_has_blind_spot consequence material;
latch_sensor_recently_serviced qualifies latch_alarm;
camera_has_blind_spot qualifies camera_frame;
examine latch_sensor_recently_serviced cost 2;
defer camera_has_blind_spot;
rule route_is_viable when corridor_clear, evacuation_route_available => door_safe;
infer route_is_viable;
choice door_decision options open, wait, reroute retaining door_unsafe, camera_has_blind_spot;
select door_decision open;

evidence smoke_report from "hallway_detector";
when_committed open smoke_report opposes corridor_clear;
when_committed open reopen open because camera_has_blind_spot;
when_committed wait smoke_report supports door_unsafe;
when_committed reroute smoke_report opposes corridor_clear;

claim alternate_route_clear;
evidence stairwell_report from "stairwell_sensor";
stairwell_report supports alternate_route_clear;
caveat stairwell_report_delayed consequence material;
stairwell_report_delayed qualifies stairwell_report;
choice revised_decision options continue, retreat, stairwell retaining smoke_report, camera_has_blind_spot, stairwell_report_delayed;
select revised_decision stairwell;
