scene "03:40. The storm has cut Saint Orin off from the mainland. Offshore, the ferry Meridian carries thirty-two people toward a light that no longer turns. You are the island's last keeper. Find a way to bring them through the night, and keep an honest account of what you do not know.";

place keeper_court kind courtyard;
place lighthouse_base kind lighthouse;
place lantern_room kind lantern_room;
place observatory kind observatory;
place tidal_archive kind archive;
place harbor kind harbor;
place breakwater kind breakwater;
connect keeper_court to lighthouse_base;
connect lighthouse_base to lantern_room;
connect keeper_court to observatory;
connect keeper_court to tidal_archive;
connect keeper_court to harbor;
connect harbor to breakwater;
entity lamp kind beacon at lantern_room;
entity lens kind optic at lantern_room;
entity radio kind transmitter at observatory;
entity star_scope kind telescope at observatory;
entity tide_table kind chart at tidal_archive;
entity tide_gauge kind gauge at harbor;
entity buoy kind buoy at breakwater;
entity dynamo kind generator at lighthouse_base;
entity pilot_boat kind boat at harbor;
entity chart_board kind chart at keeper_court;
start_at keeper_court;

display game_title "THE LAST BEACON";
display game_subtitle "An island. A missing light. Thirty-two lives offshore.";
display game_intro "You have three watches of attention before dawn. In each watch, investigate one uncertainty and make one commitment. New evidence can reopen a decision. What you never checked stays with you.";
display keeper_court "Keeper's court";
display lighthouse_base "The lighthouse";
display lantern_room "Lantern room";
display observatory "Storm observatory";
display tidal_archive "Tidal archive";
display harbor "Saint Orin harbor";
display breakwater "The breakwater";
display lamp "Fresnel beacon";
display lens "Salt-clouded lens";
display radio "Coast transmitter";
display star_scope "Survey telescope";
display tide_table "Keeper's tide atlas";
display tide_gauge "Harbor tide gauge";
display buoy "Channel marker";
display dynamo "Reserve dynamo";
display pilot_boat "Island pilot launch";
display chart_board "Keeper's chart board";

display first_watch "I / Read the darkness";
display first_watch_body "The last keeper left three assurances: a clear outer lane, a sheltered inner channel, and a voice on the radio. There is time to check one before you act.";
display first_signal "II / Make a first commitment";
display first_signal_body "Choose which assurance to put to the test. Your route will return to the court, but the evidence you bring back will change what you can honestly believe.";
display changed_water "III / Listen to what changed";
display changed_water_body "Your first commitment has reopened. The storm exposed something the old record missed. Spend a second watch on the tide, the reserve, or the ferry's true position.";
display revised_plan "IV / Prepare a way through";
display revised_plan_body "The ferry is closer. Prepare the solution you now trust most. Preparation cannot erase the caveats, and the world may answer with another objection.";
display final_watch "V / One last question";
display final_watch_body "One watch remains. Check the fact that would most change your final decision. Two other uncertainties will remain unexamined when dawn finds you.";
display final_signal "VI / Choose what to save";
display final_signal_body "No more time for another survey. Restore the beam, send the pilot, or cancel the crossing. Each is a real commitment with a different cost. Your record of doubt goes with you.";

display outer_lane_safe "The old beam marks a safe outer lane.";
display inner_channel_safe "The charted inner channel is still navigable.";
display contact_confirmed "The radio is carrying a live reply from Meridian.";
display beacon_viable "A restored beacon can guide Meridian into harbor.";
display pilot_viable "The pilot can bring the passengers to the sheltered beach.";
display holding_viable "Meridian can wait safely beyond the shoal.";
display harbor_arrival "Meridian reaches Saint Orin harbor under the restored light.";
display beach_rescue "The pilot brings the passengers to the sheltered beach.";
display crossing_postponed "Meridian holds offshore and the crossing is postponed.";

display lens_salt "Inspect the lighthouse lens";
display lens_salt_hint "A bright light can still point a ship the wrong way.";
display lens_salt_uncertainty "Salt on the lens may displace the apparent lane.";
display lens_salt_result "Up in the lantern room, a salt seam doubles the sector line. The reassuring flash is real. Its direction is not reliable. You return to the court with a rubbing of the glass.";
display chart_age "Read the tidal archive";
display chart_age_hint "A detailed chart is only as recent as its shoreline.";
display chart_age_uncertainty "The inner-channel chart predates the last surge.";
display chart_age_result "A penciled date in the archive is three winters old. Beneath it, a later keeper wrote: sand moving east. The printed channel and today's water may no longer agree.";
display radio_echo "Trace the radio reply";
display radio_echo_hint "A familiar voice may be an old transmission.";
display radio_echo_uncertainty "The storm relay may be repeating an earlier call.";
display radio_echo_result "At the observatory, you time the same breath between identical words. The relay is replaying a stored call. Hearing Meridian is not the same as knowing where she is now.";

display trust_beam "Test the outer light";
display trust_beam_hint "Climb the tower and sight the lane from the glass.";
display trust_beam_result "You sight along the old beam. Two white sectors appear on the water, and one ends on Black Tooth reef. You return to the court. The beam cannot be trusted as it stands. Your commitment reopens.";
display trust_chart "Walk the inner channel";
display trust_chart_hint "Take the atlas to the breakwater and check its marks.";
display trust_chart_result "At the breakwater, a charted marker lies beneath breaking water. The channel has moved since the last survey. You return to the court. The old route is not a promise. Your commitment reopens.";
display trust_radio "Answer the recorded bearing";
display trust_radio_hint "Use the observatory receiver to challenge the call.";
display trust_radio_result "You call for Meridian's present bearing and hear your own challenge buried inside the repeating burst. It is relay feedback, not an answer. You return to the court. Your commitment reopens.";

display tide_lag "Measure the harbor tide";
display tide_lag_hint "Check whether a small boat has a real passage left.";
display tide_lag_uncertainty "The harbor gauge may lag the water over the shoal.";
display tide_lag_result "The gauge is falling, but a strip of sheltered water still runs behind the shoal. A shallow pilot launch could use it. A laden ferry should not follow. You mark the distinction on the court chart.";
display reserve_unknown "Load-test the reserve dynamo";
display reserve_unknown_hint "Enough voltage is not the same as enough endurance.";
display reserve_unknown_uncertainty "The reserve circuit has not been tested under sustained load.";
display reserve_unknown_result "The dynamo reaches lamp voltage. Its reserve is short, and the main circuit has taken seawater. A bypass could sustain a narrow approach, not a whole night of light.";
display bearing_drift "Find the ferry through the telescope";
display bearing_drift_hint "Replace the radio's old bearing with an observation.";
display bearing_drift_uncertainty "Rain and drift make the ferry's position uncertain.";
display bearing_drift_result "Between curtains of rain, Meridian's mast light appears beyond the outer shoal. She still has room to turn offshore. You return with a present bearing, not a voice from the past.";

display bridge_reserve "Prepare the reserve bypass";
display bridge_reserve_hint "Give the lighthouse a chance at one controlled approach.";
display bridge_reserve_result "You bridge the failed supply at the tower base. The reserve answers, then the cable sheath begins to soften. The preparation holds, but a continuous burn would fail. Back at the court, your plan reopens around the risk of heat.";
display mark_channel "Reset the pilot's channel mark";
display mark_channel_hint "Prepare a shallow route for the island launch.";
display mark_channel_result "You reset the breakwater buoy against the gauge. Fresh sand curls through its chain. The launch may pass, but yesterday's depth cannot guarantee today's clearance. You return to the court with your plan reopened.";
display establish_contact "Establish a live listening watch";
display establish_contact_hint "Find out whether holding offshore is still possible.";
display establish_contact_result "A fresh voice finally cuts through the relay: Meridian's engine is losing power. Waiting is no longer passive safety. She will need an anchorage she can actually hold. You return to the court and reopen the plan.";

display beam_heat "Check the cooling interval";
display beam_heat_hint "Can a pulsed beam survive long enough for the approach?";
display beam_heat_uncertainty "A restored beam may overheat before the approach is complete.";
display beam_heat_result "At the tower base, short pulses let the cable cool between flashes. It can carry a controlled approach if someone stays with the breaker. There is no margin for an unattended beacon.";
display shoal_depth "Sound the pilot channel";
display shoal_depth_hint "Can the launch pass where the ferry cannot?";
display shoal_depth_uncertainty "The moving shoal may leave too little clearance for the launch.";
display shoal_depth_result "From the breakwater you lower the leadline three times. The launch has a hand's breadth under its keel. The ferry does not. A passenger transfer is possible, at the cost of abandoning tonight's harbor arrival.";
display anchor_hold "Check the outer anchorage";
display anchor_hold_hint "Can Meridian wait without being driven onto the reef?";
display anchor_hold_uncertainty "Meridian's anchor may drag before daylight.";
display anchor_hold_result "Through the telescope you match the ferry against two fixed lights. A live radio reply confirms chain paid out over the clay bottom. She can hold there, with a watch on the bearings. She cannot make the crossing tonight.";

display relight_beacon "Relight the last beacon";
display relight_beacon_hint "Keep the harbor approach. Stay at the breaker until dawn.";
display relight_beacon_title "THE LAST BEACON";
display relight_beacon_result "You bypass the failed feed, wipe the false sector from the lens, and send the lamp out in measured pulses. Meridian answers with one long horn. Her captain takes the outer lane while you work the breaker by hand. At dawn, thirty-two people step onto the harbor quay. The reserve is spent. You are still beside the light. The record preserves every uncertainty you carried into that decision.";
display launch_pilot "Send the island pilot";
display launch_pilot_hint "Save the passengers by the sheltered beach. Leave the beacon dark.";
display launch_pilot_title "A LIGHT IN HUMAN HANDS";
display launch_pilot_result "At the harbor you give the pilot the shallow route and release the launch. Its little light moves out beneath the dead tower. Offshore, Meridian anchors while the pilot ferries her passengers to the sheltered beach in three trips. All thirty-two reach land. The ship and her cargo must wait for salvage, and the scheduled crossing is lost. You chose a human light, and you kept the doubts that came with it.";
display hold_offshore "Order an offshore hold";
display hold_offshore_hint "Cancel the crossing. Trade tonight's arrival for daylight.";
display hold_offshore_title "THE COURAGE TO WAIT";
display hold_offshore_result "From the observatory you transmit the outer anchorage and the order nobody wanted: do not approach. Meridian pays out chain beyond the shoal. You and her captain hold a bearing watch until the rain thins into dawn. All thirty-two remain aboard, safe but still offshore. The crossing is canceled and a daylight tow is arranged. The beacon stays dark. Your final act is to refuse a promise the night cannot support.";

display old_sector "The keeper's log calls the outer light a safe bearing.";
display old_chart "The printed atlas shows a sheltered inner channel.";
display recorded_call "The receiver repeats Meridian's familiar arrival call.";
display salt_seam "A seam of salt produces a false white sector.";
display dated_survey "The last channel survey predates three winter surges.";
display repeated_breath "An identical breath repeats inside every radio call.";
display split_beam "The second white sector points toward Black Tooth reef.";
display drowned_marker "A charted channel marker is under breaking water.";
display relay_feedback "The relay plays your new challenge inside its old message.";
display sheltered_strip "A shallow strip remains behind the moving shoal.";
display reserve_charge "The dynamo can reach lamp voltage for a limited run.";
display present_bearing "The ferry's current mast light is beyond the outer shoal.";
display hot_cable "The reserve cable heats dangerously under sustained load.";
display shifting_sand "New sand is moving through the reset buoy's chain.";
display failing_engine "A live call reports Meridian's engine losing power.";
display measured_pulses "Cooling intervals make a manually controlled approach possible.";
display leadline_clearance "The shallow launch has clearance that the ferry lacks.";
display anchor_bearing "Live confirmation and fixed bearings establish the outer anchorage.";
display beacon_arrival "Meridian follows the pulsed beacon into harbor.";
display pilot_transfer "The pilot transfers the passengers to the sheltered beach.";
display offshore_hold "Meridian holds offshore for a daylight tow.";

budget 3;
claim outer_lane_safe;
claim inner_channel_safe;
claim contact_confirmed;
claim beacon_viable;
claim pilot_viable;
claim holding_viable;
claim harbor_arrival;
claim beach_rescue;
claim crossing_postponed;

evidence old_sector from "keeper_log";
evidence old_chart from "tide_table";
evidence recorded_call from "radio";
evidence salt_seam from "lens";
evidence dated_survey from "tide_table";
evidence repeated_breath from "radio";
old_sector supports outer_lane_safe;
old_chart supports inner_channel_safe;
recorded_call supports contact_confirmed;
caveat lens_salt consequence high;
caveat chart_age consequence high;
caveat radio_echo consequence material;
lens_salt qualifies old_sector;
chart_age qualifies old_chart;
radio_echo qualifies recorded_call;

investigate first_watch options lens_salt, chart_age, radio_echo;
inspect first_watch lens_salt cost 1;
reveal lens_salt then salt_seam opposes outer_lane_safe;
reveal chart_age then dated_survey opposes inner_channel_safe;
reveal radio_echo then repeated_breath opposes contact_confirmed;

choice first_signal options trust_beam, trust_chart, trust_radio retaining lens_salt, chart_age, radio_echo;
converge first_signal;
select first_signal trust_beam;
evidence split_beam from "lens";
evidence drowned_marker from "buoy";
evidence relay_feedback from "radio";
when_committed trust_beam split_beam opposes outer_lane_safe;
when_committed trust_beam reopen trust_beam because lens_salt;
when_committed trust_chart drowned_marker opposes inner_channel_safe;
when_committed trust_chart reopen trust_chart because chart_age;
when_committed trust_radio relay_feedback opposes contact_confirmed;
when_committed trust_radio reopen trust_radio because radio_echo;

evidence sheltered_strip from "tide_gauge";
evidence reserve_charge from "dynamo";
evidence present_bearing from "star_scope";
caveat tide_lag consequence high;
caveat reserve_unknown consequence high;
caveat bearing_drift consequence material;
tide_lag qualifies sheltered_strip;
reserve_unknown qualifies reserve_charge;
bearing_drift qualifies present_bearing;
investigate changed_water options tide_lag, reserve_unknown, bearing_drift;
inspect changed_water reserve_unknown cost 1;
reveal tide_lag then sheltered_strip supports pilot_viable;
reveal tide_lag then sheltered_strip opposes inner_channel_safe;
reveal reserve_unknown then reserve_charge supports beacon_viable;
reveal bearing_drift then present_bearing supports holding_viable;

choice revised_plan options bridge_reserve, mark_channel, establish_contact retaining lens_salt, chart_age, radio_echo, tide_lag, reserve_unknown, bearing_drift;
converge revised_plan;
select revised_plan bridge_reserve;
evidence hot_cable from "dynamo";
evidence shifting_sand from "buoy";
evidence failing_engine from "radio";
when_committed bridge_reserve hot_cable opposes beacon_viable;
when_committed bridge_reserve reopen bridge_reserve because reserve_unknown;
when_committed mark_channel shifting_sand opposes pilot_viable;
when_committed mark_channel reopen mark_channel because tide_lag;
when_committed establish_contact failing_engine opposes holding_viable;
when_committed establish_contact reopen establish_contact because bearing_drift;

evidence measured_pulses from "dynamo";
evidence leadline_clearance from "breakwater";
evidence anchor_bearing from "star_scope";
caveat beam_heat consequence high;
caveat shoal_depth consequence high;
caveat anchor_hold consequence high;
beam_heat qualifies measured_pulses;
shoal_depth qualifies leadline_clearance;
anchor_hold qualifies anchor_bearing;
investigate final_watch options beam_heat, shoal_depth, anchor_hold;
inspect final_watch beam_heat cost 1;
reveal beam_heat then measured_pulses supports beacon_viable;
reveal shoal_depth then leadline_clearance supports pilot_viable;
reveal anchor_hold then anchor_bearing supports holding_viable;

choice final_signal options relight_beacon, launch_pilot, hold_offshore retaining lens_salt, chart_age, radio_echo, tide_lag, reserve_unknown, bearing_drift, beam_heat, shoal_depth, anchor_hold;
select final_signal relight_beacon;
evidence beacon_arrival from "lamp";
evidence pilot_transfer from "pilot_boat";
evidence offshore_hold from "radio";
when_committed relight_beacon beacon_arrival supports harbor_arrival;
when_committed launch_pilot pilot_transfer supports beach_rescue;
when_committed hold_offshore offshore_hold supports crossing_postponed;

action lens_salt from keeper_court to keeper_court steps move lighthouse_base, move lantern_room, inspect lens, observe salt_seam, move lighthouse_base, move keeper_court;
action chart_age from keeper_court to keeper_court steps move tidal_archive, inspect tide_table, observe dated_survey, move keeper_court;
action radio_echo from keeper_court to keeper_court steps move observatory, inspect radio, observe repeated_breath, move keeper_court;
action trust_beam from keeper_court to keeper_court steps move lighthouse_base, move lantern_room, inspect lens, observe split_beam, move lighthouse_base, move keeper_court;
action trust_chart from keeper_court to keeper_court steps move harbor, move breakwater, inspect buoy, observe drowned_marker, move harbor, move keeper_court;
action trust_radio from keeper_court to keeper_court steps move observatory, inspect radio, observe relay_feedback, move keeper_court;
action tide_lag from keeper_court to keeper_court steps move harbor, inspect tide_gauge, observe sheltered_strip, move keeper_court;
action reserve_unknown from keeper_court to keeper_court steps move lighthouse_base, inspect dynamo, observe reserve_charge, move keeper_court;
action bearing_drift from keeper_court to keeper_court steps move observatory, inspect star_scope, observe present_bearing, move keeper_court;
action bridge_reserve from keeper_court to keeper_court steps move lighthouse_base, operate dynamo, observe hot_cable, move keeper_court;
action mark_channel from keeper_court to keeper_court steps move harbor, move breakwater, operate buoy, observe shifting_sand, move harbor, move keeper_court;
action establish_contact from keeper_court to keeper_court steps move observatory, inspect radio, observe failing_engine, move keeper_court;
action beam_heat from keeper_court to keeper_court steps move lighthouse_base, inspect dynamo, observe measured_pulses, move keeper_court;
action shoal_depth from keeper_court to keeper_court steps move harbor, move breakwater, inspect buoy, observe leadline_clearance, move harbor, move keeper_court;
action anchor_hold from keeper_court to keeper_court steps move observatory, inspect star_scope, inspect radio, observe anchor_bearing, move keeper_court;
action relight_beacon from keeper_court to lantern_room steps move lighthouse_base, operate dynamo, move lantern_room, operate lens, operate lamp, observe beacon_arrival;
action launch_pilot from keeper_court to harbor steps move harbor, inspect tide_gauge, operate pilot_boat, observe pilot_transfer;
action hold_offshore from keeper_court to observatory steps move observatory, inspect star_scope, operate radio, observe offshore_hold;
