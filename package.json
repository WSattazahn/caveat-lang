{
  "name": "caveat-lang-games",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Build and verify the CAVEAT language browser games",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "assemble": "node scripts/build-web.mjs --assemble-only",
    "serve": "node scripts/serve.mjs",
    "test:beacon": "node scripts/test-beacon.mjs",
    "test:launch": "node scripts/test-launch.mjs",
    "package:game": "node scripts/package-standalone.mjs",
    "test:rescue": "node scripts/test-rescue.mjs",
    "test:slime-glow": "node scripts/test-slime-glow.mjs",
    "test:glowcap": "node scripts/test-glowcap.mjs",
    "test:glowcap-page": "node scripts/test-glowcap-page.mjs",
    "test:elapsed-clock": "node scripts/test-elapsed-clock.mjs",
    "test:dispatch-outcomes": "node scripts/test-dispatch-outcomes.mjs",
    "test:trail-rescue": "node experiments/trail-rescue/harness.mjs",
    "test:trail-rescue-page": "node scripts/test-trail-rescue-page.mjs",
    "test:kit": "npm --prefix kit test",
    "test:kit-browser": "node scripts/test-kit-browser.mjs",
    "test:kit-package": "node scripts/test-kit-package.mjs",
    "check:notices": "node scripts/third-party-notices.mjs --check",
    "test:scenario-conversion": "node experiments/scenario-conversion/convert.mjs --check",
    "check:scenario-mutations": "node experiments/scenario-conversion/mutation-check.mjs",
    "test:vscode": "npm --prefix editors/vscode test",
    "package:vscode": "npm --prefix editors/vscode run package"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "playwright": "1.55.0"
  }
}
