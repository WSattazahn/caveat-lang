"""The native runtime: the npm kit's WebReactiveSession, method for method.

Every method takes and returns the runtime's own text. Use the ``caveat_lang``
package instead; this module is its private half.
"""

class RuntimeFailure(Exception):
    """The runtime returned an error; its text is the message."""

class Trap(Exception):
    """The runtime panicked, the native counterpart of a WebAssembly trap."""

class NativeSession:
    def __init__(self, source: str) -> None: ...
    @staticmethod
    def restore(source: str, saved: str) -> NativeSession: ...
    @staticmethod
    def check(source: str) -> str: ...
    @staticmethod
    def check_with(source: str, unused: bool) -> str: ...
    @staticmethod
    def check_options(source: str, options: str) -> str: ...
    @staticmethod
    def interface(source: str) -> str: ...
    def dispatch_outcome(self, event: str, payload_json: str) -> str: ...
    def dispatch_view_outcome(self, event: str, payload_json: str) -> str: ...
    def dispatch_view_fields_outcome(self, event: str, payload_json: str, fields_json: str) -> str: ...
    def dispatch_view_delta_outcome(self, event: str, payload_json: str) -> str: ...
    def dispatch_outcome_as(self, event: str, payload_json: str, agent: str) -> str: ...
    def dispatch_view_outcome_as(self, event: str, payload_json: str, agent: str) -> str: ...
    def dispatch_view_fields_outcome_as(self, event: str, payload_json: str, fields_json: str, agent: str) -> str: ...
    def dispatch_view_delta_outcome_as(self, event: str, payload_json: str, agent: str) -> str: ...
    def snapshot(self) -> str: ...
    def snapshot_compact(self) -> str: ...
    def view(self) -> str: ...
    def view_v2(self) -> str: ...
    def save(self) -> str: ...
    def save_compact(self) -> str: ...
    def save_compact_positional(self) -> str: ...
    def drain_archive(self) -> str: ...
    def undrained(self) -> int: ...
