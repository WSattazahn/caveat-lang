{
  "schema": "caveat-scenarios/0.1",
  "source": "fixture.cav",
  "scenarios": [
    {"id": "S01", "title": "An agent's pull request: only the file an earlier test backs leaves the list; its own test, its prose and a spec-only file stay",
     "steps": [
       {"send": "checks", "payload": {"ok": 1}},
       {"send": "wrote", "payload": {"file": "f1", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f2", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f3", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f4", "by": "agent"}},
       {"send": "named", "payload": {"file": "f1", "test": "t1", "origin": "added"}},
       {"send": "named", "payload": {"file": "f1", "test": "t2", "origin": "before"}},
       {"send": "cited", "payload": {"file": "f4", "spec": "s1", "origin": "before"}},
       {"send": "decide", "payload": {"file": "f1"}},
       {"send": "decide", "payload": {"file": "f2"}},
       {"send": "decide", "payload": {"file": "f3"}},
       {"send": "decide", "payload": {"file": "f4"}},
       {"expect": {"/bindings/f1/listed": 0, "/bindings/f1/why": "tests from before this pull request name it and pass on its head", "/bindings/f2/listed": 1, "/bindings/f2/why": "it rests on the agent's word only", "/bindings/f3/listed": 1, "/bindings/f3/why": "it rests on the agent's word only", "/bindings/f4/listed": 1, "/bindings/f4/why": "it rests on the agent's word only", "/commitment_grounds/f1_ok@1": {"evidence": {"$set": ["f1_account", "head_checks", "t1_text", "t2_text"]}, "caveats": {"$set": ["agent_written", "unreviewed"]}}, "/commitment_grounds/f4_ok@1": {"evidence": {"$set": ["f4_account", "s1_text"]}, "caveats": ["unreviewed"]}}},
       {"send": "decide", "payload": {"file": "f1"}, "rejected": "Already decided."}
     ]},
    {"id": "S02", "title": "A file backed only by tests the agent wrote stays on the list, and failed checks back nothing",
     "steps": [
       {"send": "checks", "payload": {"ok": 0}},
       {"send": "wrote", "payload": {"file": "f1", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f2", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f3", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f4", "by": "agent"}},
       {"send": "named", "payload": {"file": "f1", "test": "t1", "origin": "added"}},
       {"send": "named", "payload": {"file": "f1", "test": "t2", "origin": "before"}},
       {"send": "cited", "payload": {"file": "f4", "spec": "s1", "origin": "before"}},
       {"send": "decide", "payload": {"file": "f1"}},
       {"send": "decide", "payload": {"file": "f2"}},
       {"send": "decide", "payload": {"file": "f3"}},
       {"send": "decide", "payload": {"file": "f4"}},
       {"expect": {"/bindings/f1/listed": 1, "/bindings/f1/why": "only tests the agent wrote in this pull request back it", "/commitment_grounds/f1_ok@1": {"evidence": {"$set": ["f1_account", "t1_text"]}}}}
     ]},
    {"id": "S03", "title": "A person's comment takes that file off the list, and only that file",
     "steps": [
       {"send": "checks", "payload": {"ok": 1}},
       {"send": "wrote", "payload": {"file": "f1", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f2", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f3", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f4", "by": "agent"}},
       {"send": "named", "payload": {"file": "f1", "test": "t1", "origin": "added"}},
       {"send": "named", "payload": {"file": "f1", "test": "t2", "origin": "before"}},
       {"send": "cited", "payload": {"file": "f4", "spec": "s1", "origin": "before"}},
       {"send": "commented", "payload": {"file": "f4"}},
       {"send": "decide", "payload": {"file": "f1"}},
       {"send": "decide", "payload": {"file": "f2"}},
       {"send": "decide", "payload": {"file": "f3"}},
       {"send": "decide", "payload": {"file": "f4"}},
       {"expect": {"/bindings/f4/listed": 0, "/bindings/f4/why": "a person reviewed it", "/bindings/f3/listed": 1, "/commitment_grounds/f4_ok@1": {"evidence": {"$set": ["f4_account", "f4_comment", "s1_text"]}, "caveats": []}}},
       {"send": "commented", "payload": {"file": "f4"}, "rejected": "Comment already recorded."}
     ]},
    {"id": "S04", "title": "An approval clears every file",
     "steps": [
       {"send": "checks", "payload": {"ok": 1}},
       {"send": "wrote", "payload": {"file": "f1", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f2", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f3", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f4", "by": "agent"}},
       {"send": "named", "payload": {"file": "f1", "test": "t1", "origin": "added"}},
       {"send": "named", "payload": {"file": "f1", "test": "t2", "origin": "before"}},
       {"send": "cited", "payload": {"file": "f4", "spec": "s1", "origin": "before"}},
       {"send": "approved"},
       {"send": "decide", "payload": {"file": "f1"}},
       {"send": "decide", "payload": {"file": "f2"}},
       {"send": "decide", "payload": {"file": "f3"}},
       {"send": "decide", "payload": {"file": "f4"}},
       {"expect": {"/bindings/f2/listed": 0, "/bindings/f2/why": "a person reviewed it", "/bindings/f3/listed": 0}},
       {"send": "approved", "rejected": "Approval already recorded."}
     ]},
    {"id": "S05", "title": "A test changed on main later puts back exactly the files that rested on it, and keeps what they rested on",
     "steps": [
       {"send": "checks", "payload": {"ok": 1}},
       {"send": "wrote", "payload": {"file": "f1", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f2", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f3", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f4", "by": "agent"}},
       {"send": "named", "payload": {"file": "f1", "test": "t1", "origin": "added"}},
       {"send": "named", "payload": {"file": "f1", "test": "t2", "origin": "before"}},
       {"send": "cited", "payload": {"file": "f4", "spec": "s1", "origin": "before"}},
       {"send": "decide", "payload": {"file": "f1"}},
       {"send": "decide", "payload": {"file": "f2"}},
       {"send": "decide", "payload": {"file": "f3"}},
       {"send": "decide", "payload": {"file": "f4"}},
       {"send": "test_changed", "payload": {"test": "t2"}},
       {"expect": {"/bindings/f1/listed": 1, "/bindings/f1/why": "check it again: a test or spec it rested on has changed since", "/bindings/f4/why": "it rests on the agent's word only", "/commitment_grounds/f1_ok@1": {"evidence": {"$set": ["f1_account", "head_checks", "t1_text", "t2_text"]}}}},
       {"send": "test_changed", "payload": {"test": "t2"}, "rejected": "Already recorded as changed."}
     ]},
    {"id": "S06", "title": "A person's pull request lists nothing until a spec it cited changes",
     "steps": [
       {"send": "checks", "payload": {"ok": 1}},
       {"send": "wrote", "payload": {"file": "f1", "by": "person"}},
       {"send": "wrote", "payload": {"file": "f2", "by": "person"}},
       {"send": "wrote", "payload": {"file": "f3", "by": "person"}},
       {"send": "wrote", "payload": {"file": "f4", "by": "person"}},
       {"send": "named", "payload": {"file": "f1", "test": "t1", "origin": "added"}},
       {"send": "named", "payload": {"file": "f1", "test": "t2", "origin": "before"}},
       {"send": "cited", "payload": {"file": "f4", "spec": "s1", "origin": "before"}},
       {"send": "decide", "payload": {"file": "f1"}},
       {"send": "decide", "payload": {"file": "f2"}},
       {"send": "decide", "payload": {"file": "f3"}},
       {"send": "decide", "payload": {"file": "f4"}},
       {"expect": {"/bindings/f1/listed": 0, "/bindings/f3/listed": 0, "/bindings/f3/why": "written by a person", "/bindings/f4/listed": 0}},
       {"send": "spec_changed", "payload": {"spec": "s1"}},
       {"expect": {"/bindings/f4/listed": 1, "/bindings/f4/why": "check it again: a test or spec it rested on has changed since", "/bindings/f3/listed": 0}}
     ]},
    {"id": "S07", "title": "Facts about a file need who wrote it first, and a change to something nothing rested on is refused",
     "steps": [
       {"send": "named", "payload": {"file": "f1", "test": "t1", "origin": "added"}, "rejected": "Record who wrote it first."},
       {"send": "decide", "payload": {"file": "f1"}, "rejected": "Record who wrote it first."},
       {"send": "test_changed", "payload": {"test": "t1"}, "rejected": "Nothing rested on that test."},
       {"send": "wrote", "payload": {"file": "f1", "by": "agent"}},
       {"send": "wrote", "payload": {"file": "f1", "by": "agent"}, "rejected": "Already recorded who wrote it."},
       {"send": "decide", "payload": {"file": "f1"}},
       {"expect": {"/bindings/f1/listed": 1, "/bindings/f2/listed": 0, "/bindings/f2/why": "not decided"}}
     ]}
  ]
}
