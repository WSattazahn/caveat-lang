scene "Merged pull requests and what each merge rested on: its checks, its reviews and the agent that wrote it, with what was later found wrong.";

# A template: pr-ledger.mjs writes one copy per chapter of the record, with
# one `source` entity per check, reviewer and author the chapter has seen and
# its limits filled in. The record (chapter.json) names what each source is.

claim sound;   # the merged change was sound

place repo kind repo;
# @SOURCES@

evidence merges_seen from "GitHub's record that a pull request merged";
renewable merges_seen limit @MERGES@;
evidence finding from "a later finding that a check run, a review or an agent's pull request was wrong";
renewable finding limit @FINDINGS@;

# What the merge being recorded rests on: the pull request number, plus
# every passing check, approving review and author reading sent for it.
state basis = 0;
decisions main limit @MERGES@;   # one revision per merge; value: the pull request number

event pr number min 1 max 999999999;   # a merged pull request's record begins
event saw name kind source, ok min 0 max 1;   # 1 passed, approved or wrote it; 0 failed or asked for changes
event merge;                           # the pull request merged on what was sent since `pr`
event wrong name kind source, index min 1 max @LIMIT@;   # that source's Nth reading was later found wrong

on pr set basis = number;
on merge when observed(merges_seen) renew merges_seen;
on merge reveal merges_seen;
on wrong when observed(finding) renew finding;
on wrong reveal finding;

for source as $s routed by name {
    evidence $s_report from "what GitHub said about $s on each pull request";
    readings $s from $s_report limit @LIMIT@;
    on saw when ok == 1 sample $s = 1 supports sound;
    on saw when ok == 0 sample $s = 0 opposes sound;
    # Only what passed or approved is what the merge rested on.
    on saw when ok == 1 set basis = basis + 0 * latest($s);
    on wrong when index > history_count($s) reject "No such reading.";
    on wrong when withdrawn(reading($s, index)) reject "Already found wrong.";
    on wrong withdraw reading($s, index) because finding;
};

# Each merge supersedes the one before it: main moved on. A finding never
# rewrites a merge's grounds; it withdraws the reading, and `dependents`
# names every merge whose grounds hold it.
on merge when committed(main) and not reopened(main) reopen main because merges_seen;
on merge commit main because enough using basis;
