scene "Emergency lights pulse red. The evacuation corridor is behind a sealed door, and the building systems disagree about whether opening it is safe.";
place start_corridor kind corridor;
place cross_corridor kind corridor;
place continuation_corridor kind corridor;
place alternate_route kind corridor;
place stair_landing kind stairwell;
place stair_flight_down kind stairwell;
entity door_a kind fire_door at start_corridor;
entity stair_door_b kind fire_door at cross_corridor;
connect start_corridor to cross_corridor via door_a;
connect cross_corridor to continuation_corridor;
connect start_corridor to alternate_route;
connect cross_corridor to stair_landing via stair_door_b;
connect stair_landing to stair_flight_down;
display latch_sensor_recently_serviced "Check the maintenance record for the latch sensor.";
display camera_has_blind_spot "Inspect the camera coverage for blind spots.";
display maintenance_record "Maintenance log: the latch sensor failed calibration twice after servicing.";
display coverage_test "Camera diagnostic: a blind turn hides the final twelve meters of corridor.";
display open "Open the sealed door.";
display wait "Wait for more information.";
display reroute "Abandon this corridor and reroute.";
display continue "Continue with the earlier plan.";
display retreat "Retreat from the corridor.";
display stairwell "Take the alternate stairwell.";
budget 3;
claim corridor_clear;
claim door_safe;
claim door_unsafe;
claim evacuation_route_available;
claim latch_alarm_reliable;
evidence camera_frame from "camera_7";
evidence latch_alarm from "latch_sensor";
evidence route_map from "evacuation_plan";
evidence maintenance_record from "maintenance_log";
evidence coverage_test from "camera_diagnostic";
camera_frame supports corridor_clear;
latch_alarm supports door_unsafe;
route_map supports evacuation_route_available;
caveat latch_sensor_recently_serviced consequence high;
caveat camera_has_blind_spot consequence material;
latch_sensor_recently_serviced qualifies latch_alarm;
camera_has_blind_spot qualifies camera_frame;
investigate predoor options latch_sensor_recently_serviced, camera_has_blind_spot;
inspect predoor latch_sensor_recently_serviced cost 2;
reveal latch_sensor_recently_serviced then maintenance_record opposes latch_alarm_reliable;
reveal camera_has_blind_spot then coverage_test opposes corridor_clear;
rule route_is_viable when corridor_clear, evacuation_route_available => door_safe;
infer route_is_viable;
choice door_decision options open, wait, reroute retaining door_unsafe, camera_has_blind_spot;
select door_decision open;
evidence smoke_report from "hallway_detector";
when_committed open smoke_report opposes corridor_clear;
when_committed open reopen open because camera_has_blind_spot;
when_committed wait smoke_report supports door_unsafe;
when_committed reroute smoke_report opposes corridor_clear;
claim alternate_route_clear;
evidence stairwell_report from "stairwell_sensor";
stairwell_report supports alternate_route_clear;
caveat stairwell_report_delayed consequence material;
stairwell_report_delayed qualifies stairwell_report;
choice revised_decision options continue, retreat, stairwell retaining smoke_report, camera_has_blind_spot, stairwell_report_delayed;
select revised_decision stairwell;
